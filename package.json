    "kotlin:staging-properties": "node scripts/ops/write-kotlin-staging-properties.mjs",
    "test:kotlin-staging-properties": "node --test scripts/ops/write-kotlin-staging-properties.test.mjs",
    "deploy:staging-pages": "node scripts/ops/deploy-staging-pages.mjs",
