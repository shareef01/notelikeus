{
  "$schema-note": "Notelikeus design tokens. 'value' is the canonical target. 'web' and 'compose' record what each client ships today where it differs (drift to close, see DESIGN_SYSTEM.md §2.4). Colours are sRGB hex.",
  "version": "2026.10",
  "color": {
    "light": {
      "background": { "value": "#F4F4F2", "web": "#F7F7F7", "compose": "#F0F0F0", "use": "App canvas behind cards" },
      "surface": { "value": "#FFFFFF", "use": "Cards, editor, sheets" },
      "surfaceVariant": { "value": "#ECECEA", "web": "#EFEFEF", "compose": "#E5E5E5", "use": "Inputs, selected rows, chips" },
      "onSurface": { "value": "#151515", "web": "#111111", "compose": "#1A1A1A", "use": "Primary text and icons" },
      "onSurfaceSecondary": { "value": "#4D4D4B", "web": "#525252", "compose": "#4A4A4A", "use": "Body preview, metadata" },
      "muted": { "value": "#666663", "web": "#6B6B6B", "compose": "#646464", "use": "Placeholders, timestamps — ≥4.5:1 on surface, background and surfaceVariant. On a coloured note use the note text colour at 80% instead." },
      "outline": { "value": "#D6D6D3", "web": "#D8D8D8", "compose": "#D1D1D1", "use": "Card borders, dividers" }
    },
    "dark": {
      "background": { "value": "#101010", "web": "#121212", "compose": "#0F0F0F" },
      "surface": { "value": "#1B1B1B", "web": "#1C1C1C", "compose": "#1A1A1A" },
      "surfaceVariant": { "value": "#272727", "web": "#282828", "compose": "#262626" },
      "onSurface": { "value": "#EDEDED", "web": "#F5F5F5", "compose": "#E8E8E8" },
      "onSurfaceSecondary": { "value": "#B0B0B0" },
      "muted": { "value": "#949494", "web": "#9C9C9C", "compose": "#888888" },
      "outline": { "value": "#323232", "web": "#363636", "compose": "#333333" }
    },
    "trueBlack": {
      "background": { "value": "#000000" },
      "surface": { "value": "#000000" },
      "surfaceVariant": { "value": "#121212" },
      "onSurface": { "value": "#FFFFFF" },
      "muted": { "value": "#999999" },
      "outline": { "value": "#262626" }
    },
    "accent": {
      "neutral": { "light": "#151515", "dark": "#EDEDED" },
      "blue": { "light": "#0B57D0", "dark": "#A8C7FA" },
      "green": { "light": "#1B6B2E", "dark": "#9AD7A4" }
    },
    "semantic": {
      "success": { "light": "#1B6B2E", "dark": "#7FD08F", "use": "Synced" },
      "info": { "light": "#0B57D0", "dark": "#A8C7FA", "use": "Syncing, waiting to sync" },
      "caution": { "light": "#9A5B00", "dark": "#F5B544", "chip": "#F59E0B", "use": "Conflict copy, offline with pending changes" },
      "danger": { "light": "#B3261E", "dark": "#F2B8B5", "use": "Save failed, sync failed, destructive actions" }
    },
    "note": {
      "red": { "light": "#FFCDD2", "dark": "#6D2B2B" },
      "orange": { "light": "#FFE0B2", "dark": "#6B4520" },
      "yellow": { "light": "#FFF59D", "dark": "#6B5C18" },
      "green": { "light": "#C8E6C9", "dark": "#2E5A32" },
      "teal": { "light": "#B2DFDB", "dark": "#1E5650" },
      "blue": { "light": "#BBDEFB", "dark": "#2A4A6E" },
      "purple": { "light": "#E1BEE7", "dark": "#4A2D62" },
      "pink": { "light": "#F8BBD0", "dark": "#6B2D48" }
    },
    "state": {
      "hoverOverlay": { "value": "onSurface @ 6%" },
      "pressedOverlay": { "value": "onSurface @ 10%" },
      "selectedOverlay": { "value": "accent @ 12% + 2px accent outline" },
      "focusRing": { "value": "2px solid accent, 2px offset" }
    }
  },
  "typography": {
    "family": { "value": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    "overline": { "size": 11, "lineHeight": 16, "weight": 600, "tracking": "0.08em", "compose": "AppType.chromeLabel" },
    "noteCardTitle": { "size": 18, "lineHeight": 28, "weight": 600, "tracking": "-0.02em", "compose": "AppType.noteCardTitle", "web": "text-note-title" },
    "noteCardBody": { "size": 15, "lineHeight": 24, "weight": 400, "tracking": "0.005em", "compose": "AppType.noteCardBody", "web": "text-note-body" },
    "editorTitle": { "size": 22, "lineHeight": 28, "weight": 600, "tracking": "-0.03em", "compose": "AppType.editorTitle" },
    "editorBody": { "size": 16, "lineHeight": 25, "weight": 400, "tracking": "0.01em", "compose": "AppType.editorBody" },
    "metadata": { "size": 12, "lineHeight": 16, "weight": 500, "tracking": "0.02em", "numeric": "tabular-nums" }
  },
  "spacing": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24, "xxxl": 32, "noteGap": 14, "layoutGap": 20 },
  "radius": { "xs": 4, "sm": 8, "md": 12, "note": 18, "sheet": 16, "pill": 999 },
  "elevation": {
    "card": { "compose": "2.dp", "web": "0 1px 3px rgb(0 0 0 / .12), 0 1px 2px -1px rgb(0 0 0 / .12)" },
    "hover": { "compose": "3.dp", "web": "0 4px 12px -2px rgb(0 0 0 / .18), 0 2px 6px -2px rgb(0 0 0 / .12)" },
    "overlay": { "compose": "6.dp" }
  },
  "motion": {
    "instant": 100, "quick": 150, "standard": 250, "emphasis": 400,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "Durations collapse to 0 except opacity fades ≤ 100 ms; no translation or scale."
  },
  "layout": {
    "breakpoints": { "compact": 0, "medium": 600, "expanded": 840, "large": 1200 },
    "minHitTarget": { "touch": 48, "pointer": 32 },
    "gutter": { "compact": 12, "medium": 20, "expanded": 24 },
    "readingWidth": "48rem"
  }
}
