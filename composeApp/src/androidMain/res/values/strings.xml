<resources>
    <!--
      Android-only resources.

      Everything the shared Compose UI renders lives in commonMain/composeResources/values/strings.xml.
      This file is deliberately limited to strings that must be reachable through the Android
      `R.string` API, i.e. from outside a composition:
        - the manifest and widget metadata in :androidApp
        - notification/channel setup and the Glance widget, which build text without a composer

      It previously mirrored all ~230 shared strings, and the two copies had already drifted apart
      (9 strings existed only in composeResources, 2 only here). Keep this list minimal: if the
      shared UI needs a string, add it to composeResources, not here.
    -->

    <!-- Manifest, widget metadata and AppFunctions (:androidApp) -->
    <string name="app_name">Notelikeus</string>
    <string name="widget_name">Notelikeus widget</string>
    <string name="app_functions_description">Capture ideas, lists, and reminders in one place.</string>
    <string name="default_web_client_id">404285880902-cpiu3nj2itndnh0kkouvn374ec5ecl9v.apps.googleusercontent.com</string>

    <!-- Reminder notifications (NotificationChannels, ReminderReceiver) -->
    <string name="reminder_channel_name">Note Reminders</string>
    <string name="reminder_default_title">Reminder</string>
    <string name="reminder_default_body">You have a note reminder</string>

    <!-- Home-screen widget (NoteWidget, WidgetNoteLoader) -->
    <string name="widget_new">+ New</string>
    <string name="widget_empty">No notes yet</string>
    <string name="untitled">Untitled</string>
    <string name="pinned_short">Pinned</string>
    <string name="app_lock_title">App lock</string>
    <string name="checklist_progress">%1$d/%2$d completed</string>
</resources>
