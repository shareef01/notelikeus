name = "notelikeus-attachments"
main = "src/index.ts"
compatibility_date = "2025-09-02"

[[r2_buckets]]
binding = "ATTACHMENTS_BUCKET"
bucket_name = "notelikeus-attachments-dev"

[vars]
SUPABASE_URL = "http://127.0.0.1:54321"
# Optional comma-separated extra Origins (localhost and notelikeus-dev.pages.dev are always allowed).
# ALLOWED_ORIGINS = "https://notes.example.com"
# Set via `wrangler secret put SUPABASE_ANON_KEY` in real deployments.
# Optional hosted orphan sweep: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
# The cron is a no-op until that secret exists.

[triggers]
crons = ["15 */6 * * *"]
