name = "notelikeus-attachments"
main = "src/index.ts"
compatibility_date = "2025-09-02"

[[r2_buckets]]
binding = "ATTACHMENTS_BUCKET"
bucket_name = "notelikeus-attachments-dev"

[vars]
SUPABASE_URL = "http://127.0.0.1:54321"
# Optional comma-separated extra Origins (localhost and notelikeus[.pages.dev] projects are always allowed).
# ALLOWED_ORIGINS = "https://notes.example.com"
# Set via `wrangler secret put SUPABASE_ANON_KEY` in real deployments.
# Required in production: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`. Without it
# `DELETE /v1/account` answers 503 and deletes nothing, a deleted attachment never releases its quota
# (only the service role may confirm its object is gone), and the cron sweeps do nothing.
# Local development can leave it out; the Worker then behaves as described and refuses rather than
# half-does. `.github/workflows/attachments-worker.yml` uploads it when the repository has a
# SUPABASE_SERVICE_ROLE_KEY secret, and warns in the job log when it does not.

# Abuse control. Cloudflare counts these at the edge, so the limit holds across every isolate the
# Worker runs in — an in-process counter would not. The Worker applies it twice per request: keyed
# by client IP before it spends a Supabase Auth call, and keyed by the authenticated user id
# afterwards. Without this binding there is no Worker-level throttling.
#
# Uncomment for a local or hand-rolled deployment. The official deploy workflow writes this same
# block from its `rate_limit_requests` / `rate_limit_period` inputs (600 per 60s by default; 0
# leaves it out entirely), so an owner-operated Worker gets it without editing anything here.
#
# Throttling is independent of authorization in both directions: it only ever returns 429, it
# fails open when the limiter cannot answer, and the object-key/ownership checks run regardless.
#
# Pick any namespace_id unique within this Worker. `simple` is requests per `period` seconds
# (period must be 10 or 60). The values below allow ten requests a second per key: a new device
# hydrating a few hundred images stays under it, and the clients do not retry a 429 on their own.
#
# [[unsafe.bindings]]
# name = "ATTACHMENT_RATE_LIMITER"
# type = "ratelimit"
# namespace_id = "1001"
# simple = { limit = 600, period = 60 }

# Request body size, connection, and CPU limits are Cloudflare platform limits, and zone-level
# WAF rules, bot protection, and per-endpoint rate limiting live in the Cloudflare dashboard or
# API for the zone in front of this Worker. None of those are configurable from this repository;
# the upload cap the Worker itself enforces is in `src/limits.ts`. Operator checklist:
# docs/CLOUDFLARE_ZONE_CONTROLS.md

[triggers]
crons = ["15 * * * *"]
