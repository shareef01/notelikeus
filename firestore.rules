rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidNote() {
      let data = request.resource.data;
      // 'isLocked' is deliberately not required: note locking has been removed, but clients
      // that predate the removal still send it, so it stays accepted (and type-checked) rather
      // than having their writes rejected.
      return data.keys().hasOnly([
          'localId', 'title', 'content', 'timestamp', 'color',
          'isPinned', 'isArchived', 'isTrashed',
          'position', 'labels', 'checklist',
          'isLocked', 'reminderTimestamp', 'attachments', 'serverUpdatedAt'
        ])
        && data.keys().hasAll([
          'localId', 'title', 'content', 'timestamp', 'color',
          'isPinned', 'isArchived', 'isTrashed',
          'position', 'labels', 'checklist'
        ])
        && data.localId is int
        && data.title is string
        && data.content is string
        && data.title.size() <= 2000
        && data.content.size() <= 100000
        && data.timestamp is int
        && data.color is int
        && data.isPinned is bool
        && data.isArchived is bool
        && data.isTrashed is bool
        && (!('isLocked' in data) || data.isLocked is bool)
        && data.position is int
        && (!('reminderTimestamp' in data)
          || data.reminderTimestamp == null
          || data.reminderTimestamp is int)
        // Type and length only, and that is the ceiling rather than an oversight.
        //
        // The rules language has no iteration: there is no loop, no comprehension, and no `all`
        // over a list, so "every element of `checklist` is a map with text/isChecked/position"
        // cannot be written here. Verified against the emulator rather than assumed — a rule using
        // `checklist.all(i, i.text is string)` denies a write whose data satisfies it, because the
        // unknown method errors and an errored condition evaluates to deny.
        //
        // Element access by index (`checklist[0].keys().hasOnly([...])`) *does* work, and was
        // deliberately not used: it can only cover indices named literally, so it would validate
        // element 0 and wave through elements 1..499. That reads like element validation without
        // being it, which is worse than the honest limit — the next person to look would take the
        // check at face value.
        //
        // What actually bounds this: only the owner can write here (`isOwner`), so the blast radius
        // of a malformed element is the writer's own note; Firestore's 1 MiB document cap bounds
        // total size; and all three clients read these arrays defensively, coercing per field
        // (`item["text"] as? String ?: ""`, `label["name"] as? String` dropped if absent). The
        // defensive readers are the real enforcement point, not this file.
        && data.labels is list
        && data.labels.size() <= 100
        && data.checklist is list
        && data.checklist.size() <= 500
        // Legacy compatibility only: attachments were removed from the product, but older clients
        // and backup/import paths still normalize this field in the shared note model. Keep
        // accepting it as a bounded list so those writes fail closed rather than punching through
        // via a broad "unknown fields" rejection that could strand older data.
        && (!('attachments' in data)
          || (data.attachments is list && data.attachments.size() <= 50))
        // Optional so clients that predate this field can still write. When present, it must be
        // exactly the server's own commit time for this write — not a value the client chose —
        // which is what makes it safe to use for cross-device conflict resolution instead of
        // the spoofable/skewable client `timestamp` field.
        && (!('serverUpdatedAt' in data) || data.serverUpdatedAt == request.time);
    }

    function isValidSyncMeta() {
      let data = request.resource.data;
      return data.keys().hasOnly(['lastSyncAt', 'noteCount', 'platform'])
        && data.keys().hasAll(['lastSyncAt', 'noteCount', 'platform'])
        && (data.lastSyncAt is number || data.lastSyncAt is timestamp)
        && data.noteCount is int
        && data.noteCount >= 0
        && data.noteCount <= 100000
        && data.platform is string
        && data.platform in ['android', 'web', 'desktop'];
    }

    function isValidConnectionMeta() {
      let data = request.resource.data;
      return data.keys().hasOnly(['connectedAt', 'platform'])
        && data.keys().hasAll(['connectedAt', 'platform'])
        && data.connectedAt is number
        && data.platform is string
        && data.platform in ['android', 'web', 'desktop'];
    }

    match /users/{userId} {
      allow read, write: if false;

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidNote();
        allow delete: if isOwner(userId);
      }

      match /tombstones/{noteId} {
        allow read: if isOwner(userId);
        // `deletedAt` is epoch millis and drives tombstone expiry, so a non-positive value is not a
        // skewed clock, it is a broken write: `pruneExpiredTombstones` compares it against a
        // retention window, and 0 or a negative reads as "deleted at or before 1970", which is
        // immediately expired. The tombstone would then be pruned before it had propagated and the
        // note would come back on every other device.
        //
        // Lower bound only, deliberately. An upper bound ("not more than a day ahead") would reject
        // the write outright on a device with a fast clock — and a rejected tombstone means the
        // deletion never propagates at all, which is a worse outcome than storing a skewed one.
        // Kept as `is number` rather than `is int` for the same reason: it is what three clients
        // already send and nothing here needs the narrower type.
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['deletedAt'])
          && request.resource.data.keys().hasAll(['deletedAt'])
          && request.resource.data.deletedAt is number
          && request.resource.data.deletedAt > 0;
        allow delete: if isOwner(userId);
      }

      match /_meta/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && ((docId == 'sync' && isValidSyncMeta())
            || (docId == 'connection' && isValidConnectionMeta()));
        allow delete: if isOwner(userId) && docId in ['sync', 'connection'];
      }
    }
  }
}
