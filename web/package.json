{
  "name": "notelikeus-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:sync": "firebase emulators:exec --only firestore \"vitest run --config vitest.emulator.config.ts\"",
    "deploy": "npm run lint && npm test && npm run build && firebase deploy --only hosting,firestore:rules",
    "test:e2e": "firebase emulators:exec --only firestore,auth \"npm run e2e:run\"",
    "e2e:run": "vite build --mode e2e --outDir dist-e2e && playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "firebase": "^12.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
