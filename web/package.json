{
  "name": "notelikeus-web",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "author": "shareef01",
  "repository": {
    "type": "git",
    "url": "https://github.com/shareef01/notelikeus.git"
  },
  "homepage": "https://github.com/shareef01/notelikeus",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy:pages": "npm run lint && npm test && npm run build && npx wrangler pages deploy dist --project-name=notelikeus-dev",
    "test:e2e": "node scripts/assertLocalSupabaseE2e.mjs && npm run e2e:run",
    "e2e:run": "vite build --mode e2e --outDir dist-e2e && playwright test",
    "verify:pages": "node scripts/verifyPagesArtifacts.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.114.0",
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.6",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
