{
  "name": "notelikeus-web",
  "private": true,
  "version": "2.6.2",
  "type": "module",
  "author": "shareef01",
  "repository": {
    "type": "git",
    "url": "https://github.com/shareef01/notelikeus.git"
  },
  "homepage": "https://github.com/shareef01/notelikeus",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "npm run test:tooling && vitest run",
    "test:coverage": "npm run test:tooling && vitest run --coverage",
    "deploy:pages": "npm run lint && npm test && npm run build && node scripts/verifyPagesArtifacts.mjs --deployable && npx wrangler pages deploy dist --project-name=notelikeus --branch=main",
    "test:e2e": "node scripts/assertLocalSupabaseE2e.mjs && npm run e2e:run",
    "test:audit-ui": "vite build --mode e2e --outDir dist-e2e && playwright test dialog-a11y.spec.ts reflow.spec.ts palette-contrast.spec.ts touch-targets.spec.ts --config playwright.audit.config.ts",
    "e2e:run": "vite build --mode e2e --outDir dist-e2e && playwright test",
    "verify:pages": "node scripts/verifyPagesArtifacts.mjs",
    "postinstall": "patch-package --error-on-fail",
    "test:tooling": "node --test scripts/dependencySecurity.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.90.0",
    "patch-package": "8.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  }
}
