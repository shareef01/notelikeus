{
  "$schema": "./node_modules/oxlint/configuration.schema.json",
  "ignorePatterns": ["dist", "dist-e2e", "playwright-report", "test-results"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "unicorn/prefer-add-event-listener": "off",
    "no-await-in-loop": "off"
  }
}
