# Loaded by `vite build --mode e2e` for the Playwright suite. Committed on purpose: every value
# here is a placeholder, and CI needs them to produce a build that boots.
#
# Nothing here can reach the real project. VITE_FIREBASE_EMULATOR_HOST redirects Auth and
# Firestore to localhost emulators, and the project id below does not exist.
VITE_FIREBASE_API_KEY=e2e-not-a-real-key
VITE_FIREBASE_AUTH_DOMAIN=notelikeus-e2e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=notelikeus-e2e
VITE_FIREBASE_STORAGE_BUCKET=notelikeus-e2e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:e2e
VITE_FIREBASE_GOOGLE_CLIENT_ID=000000000000-e2e.apps.googleusercontent.com

VITE_FIREBASE_EMULATOR_HOST=127.0.0.1:8080
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
# `vite build` is a production build, so the emulator redirect is gated off by default. This is
# the explicit opt-in that says the redirect is intended for this build.
VITE_E2E=1
