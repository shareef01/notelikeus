# Copy to .env. Production builds need a hosted Supabase project URL (not localhost).
# Local `npm run dev` can omit these and use the default local demo project from `supabase start`.

VITE_SUPABASE_URL=http://127.0.0.1:54321
# Public client key: the publishable key (sb_publishable_…) or the legacy anon JWT (eyJ…).
# Never paste a service_role key or sb_secret_… value.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Production / Pages:
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_…your-publishable-key

# Email/password test login — shown automatically in `npm run dev` and e2e builds only.
# Enable Email provider in the Supabase Auth dashboard (or local config) first.
# VITE_TEST_LOGIN_EMAIL=test@example.com
# VITE_TEST_LOGIN_PASSWORD=testpass123

# Attachments Worker (Cloudflare R2). Leave unset to keep attachment blobs local-only.
# VITE_ATTACHMENTS_WORKER_URL=http://127.0.0.1:8787

# Cloudflare Turnstile site key (public). Set for hosted builds once the hosted project requires
# CAPTCHA on code requests (supabase-auth.yml). Leave unset locally: [auth.captcha] is off there.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA…
