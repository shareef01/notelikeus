# Copy to .env and set VITE_FIREBASE_APP_ID after registering a Web app in Firebase Console.
# Project: notelikeus (shared with Android)

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
# Web OAuth client (from google-services.json, client_type 3)
VITE_FIREBASE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Optional Firebase App Check (Firebase Console → App Check → register web app)
# VITE_APPCHECK_RECAPTCHA_SITE_KEY=
# Or Enterprise:
# VITE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local debug token (true = print token in console; or paste a registered token):
# VITE_APPCHECK_DEBUG_TOKEN=true

# Email/password test login — shown automatically in `npm run dev` only (never in production builds).
# Enable Email/Password in Firebase Console → Authentication first.
# VITE_TEST_LOGIN_EMAIL=test@example.com
# VITE_TEST_LOGIN_PASSWORD=testpass123

# --- Supabase backend (dev-only unless Phase 11 cutover flags are set) ---
# Firebase remains the production default. Ordinary users cannot switch backends.
# VITE_REMOTE_BACKEND=supabase
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Production cutover build only (never set in Firebase Hosting deploys until authorized):
# VITE_ALLOW_SUPABASE_PRODUCTION=true
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Phase 5: Google OAuth uses the same VITE_FIREBASE_GOOGLE_CLIENT_ID for local Supabase.
# Configure Supabase Auth Google provider before `supabase start`:
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<Web OAuth client id>
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<Web OAuth client secret>

# --- Attachments + R2 (Phase 8, dev-only — UI wiring is Phase 9) ---
# Requires VITE_REMOTE_BACKEND=supabase and a running Cloudflare Worker (see workers/attachments/).
# VITE_ATTACHMENTS_WORKER_URL=http://127.0.0.1:8787
