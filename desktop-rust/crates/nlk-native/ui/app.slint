// The native Notelikeus window, laid out like the web app: a sidebar with Notes, Archive and Trash, a top
// bar with search and a new-note button, a masonry grid of note cards in their colours, and a
// dedicated note workspace with note options (colour, labels) and a checklist mode.
//
// Every interactive element carries an accessible role and label: screen readers use them, and so do the
// headless UI tests (tests/ui.rs).

import { AboutSlint, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme, Type, Icons, Icon, IconButton, BrandMark } from "theme.slint";
// Re-exported so Rust can set the contrast theme (src/contrast.rs) and tests can read the roles.
export { Theme, ContrastPalette } from "theme.slint";
import "fonts/inter_regular.ttf";
import "fonts/inter_medium.ttf";
import "fonts/inter_semibold.ttf";
import "fonts/inter_bold.ttf";

export struct ChecklistLine {
    text: string,
    checked: bool,
}

/// One of a note's pictures, as the window shows it: drawn once `ready`, or why it can't be.
export struct Picture {
    id: string,
    image: image,
    ready: bool,
    problem: string,
    aspect: float,
    index: int,
    inline-byte: int,
    inline-order: int,
}

export enum DocumentKind { prose, code, divider, picture }

export struct DocumentBlock {
    text: styled-text,
    description: string,
    heading: int,
    kind: DocumentKind,
    quote-depth: int,
    picture: Picture,
}

export struct NoteCard {
    id: string,
    cover: Picture,
    has-cover: bool,
    more-images: int,
    title: string,
    preview: string,
    time: string,
    reminder: string,
    reminder-overdue: bool,
    pinned: bool,
    has-color: bool,
    color-light: color,
    color-dark: color,
    labels: [string],
    more-labels: int,
    checklist: [ChecklistLine],
    more-items: int,
}

export struct CardColumn {
    cards: [NoteCard],
}

/// One checklist row in the editor. `position` is the item's stored position; `focus` asks the row to
/// take focus when it appears (a row just added).
export struct EditRow {
    position: int,
    text: string,
    checked: bool,
    focus: bool,
}

export struct Swatch {
    name: string,
    none: bool,
    light: color,
    dark: color,
}

export struct LabelChoice {
    name: string,
    on: bool,
}

/// One choice in the Filters sheet: a chip, on or off. `index` is what the callback reports.
export struct Choice {
    text: string,
    on: bool,
    index: int,
}

/// A row of chips, wrapped in Rust (Slint has no wrapping layout).
export struct ChoiceRow {
    items: [Choice],
}

/// One line of a version under conflict review; `changed` when the other version has no such line.
export struct ReviewRow {
    text: string,
    changed: bool,
}

/// A smart view or a saved filter in the sidebar.
export struct SidebarRow {
    label: string,
    count: int,
    current: bool,
}

// The note views, as the web app's sidebar.
export enum View { notes, archive, trash }

component SectionLabel inherits Text {
    font-size: Type.overline;
    font-weight: 600;
    letter-spacing: 0.9px;
    color: Theme.muted;
}

/// A chip that is on or off, as the web app's filter chips. Announced as a checkbox.
component FilterChip inherits FocusScope {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 32px;
    width: chip-label.preferred-width + (root.on ? 42px : 26px);
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            root.clicked();
            return accept;
        }
        reject
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        background: root.on ? Theme.on-surface : (touch.has-hover ? Theme.hover : transparent);
        border-width: root.has-focus ? 2px : (root.on ? 0 : 1px);
        border-color: root.has-focus ? Theme.accent : Theme.outline;
        HorizontalLayout {
            padding-left: 13px;
            padding-right: 13px;
            spacing: 4px;
            if root.on: Icon {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                path: Icons.check;
                color: Theme.background;
            }
            chip-label := Text {
                text: root.text;
                vertical-alignment: center;
                font-size: Type.body-small;
                font-weight: 500;
                color: root.on ? Theme.background : Theme.on-surface-secondary;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.focus(); root.clicked(); }
        }
    }
}

/// A single segment inside a unified segmented control (e.g. Manual | Newest | Oldest).
component SegmentTab inherits FocusScope {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 26px;
    width: seg-label.preferred-width + 22px;
    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            root.clicked();
            return accept;
        }
        reject
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 7px;
        background: root.on ? Theme.on-surface : (touch.has-hover ? Theme.hover : transparent);
        border-width: root.has-focus ? 2px : 0px;
        border-color: Theme.accent;
        seg-label := Text {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.text;
            font-size: Type.body-small;
            font-weight: root.on ? 600 : 500;
            color: root.on ? Theme.background : Theme.on-surface-secondary;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.focus(); root.clicked(); }
        }
    }
}

/// A rounded Fluent-style section card for Settings.
component SettingsCard inherits Rectangle {
    border-radius: 14px;
    background: Theme.dark ? Theme.surface-variant.transparentize(0.55) : Theme.background;
    border-width: 1px;
    border-color: Theme.outline.transparentize(0.45);
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        @children
    }
}

/// One row of filter chips (rows are wrapped in Rust: Slint has no wrapping layout).
component ChipRow inherits HorizontalLayout {
    in property <[Choice]> items;
    callback picked(Choice);
    spacing: 8px;
    alignment: start;
    for choice in root.items: FilterChip {
        text: choice.text;
        on: choice.on;
        clicked => { root.picked(choice); }
    }
}

/// One version in the conflict review: when it was edited, its title, and its lines, those only in this
/// version highlighted (and said so to a screen reader).
component ReviewVersion inherits Rectangle {
    in property <string> heading;
    in property <string> edited;
    in property <string> note-title;
    in property <[ReviewRow]> lines;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.outline;
    accessible-role: groupbox;
    accessible-label: root.heading;
    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        alignment: start;
        Text {
            text: root.heading;
            font-size: Type.overline;
            font-weight: 600;
            letter-spacing: 0.9px;
            color: Theme.on-surface-secondary;
        }
        Text { text: root.edited; font-size: Type.meta; color: Theme.muted; }
        if root.note-title != "": Text {
            text: root.note-title;
            font-size: Type.body-large;
            font-weight: 600;
            color: Theme.on-surface;
            wrap: word-wrap;
        }
        if root.lines.length == 0: Text { text: "(empty)"; font-size: Type.body; color: Theme.muted; }
        for line in root.lines: Rectangle {
            border-radius: 4px;
            background: line.changed ? Theme.caution-fill.transparentize(0.8) : transparent;
            accessible-role: text;
            accessible-label: line.text + (line.changed ? " (only in this version)" : "");
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                Text {
                    text: line.text == "" ? " " : line.text;
                    font-size: Type.body;
                    font-weight: line.changed ? 500 : 400;
                    color: Theme.on-surface;
                    wrap: word-wrap;
                }
            }
        }
    }
}

/// A rounded text button. `strong` is the filled, primary look.
component PillButton inherits FocusScope {
    in property <string> text;
    /// What a screen reader announces, when it should differ from what is shown.
    in property <string> label: root.text;
    in property <string> icon: "";
    in property <bool> strong: false;
    in property <bool> danger: false;
    callback clicked();
    height: 36px;
    preferred-width: pill-row.preferred-width + 28px;
    focus-on-tab-navigation: root.enabled;
    focus-on-click: root.enabled;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    public function focus-button() { root.focus(); }
    key-pressed(event) => {
        if ((event.text == Key.Space || event.text == Key.Return) && root.enabled) {
            root.clicked();
            return accept;
        }
        reject
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.height / 2;
        opacity: root.enabled ? 1 : 0.45;
        background: root.strong ? (root.danger ? Theme.danger : Theme.on-surface) : (touch.has-hover && root.enabled ? Theme.hover : transparent);
        border-width: root.has-focus ? 2px : (root.strong ? 0 : 1px);
        border-color: root.has-focus ? Theme.accent : Theme.outline;
        pill-row := HorizontalLayout {
            alignment: center;
            spacing: 8px;
            if root.icon != "": Icon {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                path: root.icon;
                color: root.strong ? Theme.background : (root.danger ? Theme.danger : Theme.on-surface);
            }
            label-text := Text {
                text: root.text;
                vertical-alignment: center;
                font-size: Type.body-small;
                font-weight: 600;
                color: root.strong ? Theme.background : (root.danger ? Theme.danger : Theme.on-surface);
            }
        }
        touch := TouchArea {
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { if (root.enabled) { root.focus(); root.clicked(); } }
        }
    }
}

/// A theme selector announced as a selected or unselected radio button.
component ThemeOption inherits FocusScope {
    in property <string> text;
    in property <bool> selected;
    in property <int> option-index: -1;
    in property <int> option-count: 3;
    callback clicked();
    callback move-option(int);
    height: 36px;
    width: option-label.preferred-width + 28px;
    public function focus-option() { root.focus(); }
    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked <=> selected;
    accessible-label: text;
    accessible-item-index: option-index;
    accessible-action-default => { root.clicked(); }
    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            root.clicked();
            return accept;
        }
        if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
            root.move-option(root.option-index == 0 ? root.option-count - 1 : root.option-index - 1);
            return accept;
        }
        if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
            root.move-option(root.option-index >= root.option-count - 1 ? 0 : root.option-index + 1);
            return accept;
        }
        reject
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.height / 2;
        background: root.selected ? Theme.on-surface : (touch.has-hover ? Theme.hover : transparent);
        border-width: root.has-focus ? 2px : (root.selected ? 0 : 1px);
        border-color: root.has-focus ? Theme.accent : Theme.outline;
        option-label := Text {
            text: root.text;
            font-size: Type.body-small;
            font-weight: 600;
            color: root.selected ? Theme.background : Theme.on-surface;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.focus(); root.clicked(); }
        }
    }
}

/// A checkbox: a rounded square with a tick.
component CheckBox inherits FocusScope {
    in property <bool> checked;
    in property <string> label;
    in property <length> box: 20px;
    in property <color> ink: Theme.on-surface;
    in property <color> border-ink: Theme.muted;
    in property <color> tick-ink: Theme.background;
    callback toggled();
    width: box;
    height: box;
    focus-on-tab-navigation: root.enabled;
    focus-on-click: root.enabled;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: label;
    accessible-action-default => { if (root.enabled) { root.toggled(); } }
    key-pressed(event) => {
        if ((event.text == Key.Space || event.text == Key.Return) && root.enabled) {
            root.toggled();
            return accept;
        }
        reject
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 5px;
        border-width: root.has-focus ? 2px : (root.checked ? 0 : 2px);
        background: root.checked ? root.ink : transparent;
        border-color: root.has-focus ? Theme.accent : root.border-ink;
        if root.checked: Icon {
            width: root.box - 4px;
            height: root.box - 4px;
            path: Icons.check;
            color: root.tick-ink;
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { if (root.enabled) { root.focus(); root.toggled(); } }
        }
    }
}

component NavItem inherits FocusScope {
    in property <string> icon;
    in property <string> label;
    in property <int> count: -1;
    in property <bool> selected;
    in property <bool> compact: false;
    callback clicked();
    height: 40px;
    preferred-width: root.compact ? 40px : nav-row.preferred-width;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            root.clicked();
            return accept;
        }
        reject
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        background: root.selected ? Theme.accent.transparentize(0.88) : (touch.has-hover ? Theme.hover : transparent);
        border-width: root.has-focus ? 2px : 0;
        border-color: Theme.accent;

        // Selection bar matching Kotlin SideDrawerNavItem (inside the row, 3px wide, 20px tall).
        if root.selected && !root.compact: Rectangle {
            x: 7px;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: 20px;
            border-radius: 2px;
            background: Theme.accent;
        }

        nav-row := HorizontalLayout {
            padding-left: root.compact ? 12px : 20px;
            padding-right: 12px;
            spacing: 12px;
            alignment: root.compact ? center : start;
            Icon {
                y: (parent.height - self.height) / 2;
                path: root.icon;
                color: root.selected ? Theme.accent : Theme.on-surface-secondary;
            }
            if !root.compact: Text {
                text: root.label;
                vertical-alignment: center;
                font-size: Type.body;
                font-weight: root.selected ? 600 : 500;
                color: root.selected ? Theme.on-surface : Theme.on-surface-secondary;
                horizontal-stretch: 1;
            }
            if !root.compact && root.count > 0: Rectangle {
                y: (parent.height - self.height) / 2;
                width: max(22px, count-text.preferred-width + 12px);
                height: 22px;
                border-radius: 11px;
                background: root.selected ? Theme.accent.transparentize(0.80) : Theme.accent.transparentize(0.92);
                count-text := Text {
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: root.count;
                    font-size: Type.meta;
                    font-weight: 600;
                    color: root.selected ? Theme.accent : Theme.accent.transparentize(0.15);
                }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.focus(); root.clicked(); }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.on-surface-secondary;
    in property <color> bg: Theme.on-surface.transparentize(0.9);
    height: 24px;
    width: chip-text.preferred-width + 18px;
    border-radius: 12px;
    background: root.bg;
    chip-text := Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        font-size: Type.meta;
        font-weight: 500;
        color: root.fg;
    }
}

component Card inherits FocusScope {
    in property <NoteCard> card;
    in property <bool> compact: false;
    callback clicked();
    // A note colour tints the card, except under a Windows contrast theme (Theme.note-tint).
    property <bool> tinted: card.has-color && Theme.note-tint;
    property <color> fg: root.tinted ? (Theme.dark ? #ffffff : #151515) : Theme.on-surface;
    property <color> fg-secondary: root.tinted ? (Theme.dark ? #f0f0f0 : #292927) : Theme.on-surface-secondary;
    property <color> fg-muted: root.tinted ? (Theme.dark ? #e5e5e5 : #3b3b38) : Theme.muted;
    property <color> chip-bg: root.tinted ? (Theme.dark ? #ffffff24 : #00000018) : Theme.on-surface.transparentize(0.9);
    property <color> cb-bg: root.tinted ? (Theme.dark ? #ffffff : #151515) : Theme.on-surface;
    property <color> cb-tick: root.tinted ? (Theme.dark ? #151515 : #ffffff) : Theme.background;
    preferred-width: card-layout.preferred-width;
    preferred-height: card-layout.preferred-height;
    accessible-role: button;
    accessible-label: card.title != "" ? card.title : "Untitled note";
    // The status the card shows as icons and chips, in words, ahead of the preview: Narrator otherwise
    // heard only the title and preview, while TalkBack and the web card name pin, reminder and picture.
    // In the description, not the label, so the accessible name stays the note's title.
    property <string> status-words: (card.pinned ? "Pinned. " : "")
        + (card.reminder != "" ? ((card.reminder-overdue ? "Overdue reminder " : "Reminder ") + card.reminder + ". ") : "")
        + (card.has-cover ? "Has a picture. " : "")
        + (card.checklist.length > 0 ? "Checklist. " : "");
    accessible-description: root.status-words + card.preview;
    accessible-action-default => { root.clicked(); }
    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            root.clicked();
            return accept;
        }
        reject
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-note;
        border-width: root.has-focus ? 2px : 1px;
        // A coloured card's hover edge was white at 20% in both themes, which vanishes on a light
        // pastel; a dark edge in light, a light edge in dark, so hover reads on every note colour.
        border-color: root.has-focus ? Theme.accent : (root.tinted ? (touch.has-hover ? (Theme.dark ? #ffffff40 : #00000033) : (Theme.dark ? #ffffff14 : #00000012)) : (touch.has-hover ? Theme.muted : Theme.outline));
        background: root.tinted ? (Theme.dark ? card.color-dark : card.color-light) : Theme.surface;
        // The restrained 3dp hover lift of the design system, not an 18px glow.
        drop-shadow-blur: touch.has-hover ? 10px : 0px;
        drop-shadow-offset-y: touch.has-hover ? 2px : 0px;
        drop-shadow-color: touch.has-hover ? #00000024 : transparent;
        clip: true;

        card-layout := VerticalLayout {
            padding-bottom: root.compact ? 14px : 20px;
            padding-top: card.has-cover ? 0px : (root.compact ? 14px : 20px);
            spacing: root.compact ? 6px : 10px;
            // The note's first picture leads the card edge-to-edge across the top, as on Kotlin and the web.
            if card.has-cover: Rectangle {
                height: root.compact ? 120px : 176px;
                clip: true;
                background: Theme.surface-variant;
                if card.cover.ready: Image {
                    width: parent.width;
                    height: parent.height;
                    source: card.cover.image;
                    image-fit: cover;
                    accessible-role: image;
                    accessible-label: "Picture";
                }
                if !card.cover.ready && card.cover.problem == "": Icon {
                    path: Icons.image;
                    color: Theme.muted;
                }
                if card.cover.problem != "": Text {
                    width: parent.width - 20px;
                    text: card.cover.problem;
                    font-size: Type.meta;
                    color: Theme.on-surface-secondary;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                if card.more-images > 0: Rectangle {
                    x: parent.width - self.width - 10px;
                    y: parent.height - self.height - 10px;
                    width: more-text.preferred-width + 14px;
                    height: 22px;
                    border-radius: 11px;
                    background: #000000cc;
                    more-text := Text {
                        text: "+" + card.more-images;
                        font-size: Type.meta;
                        font-weight: 600;
                        color: #ffffff;
                    }
                }
            }
            HorizontalLayout {
                padding-left: root.compact ? 14px : 20px;
                padding-right: root.compact ? 14px : 20px;
                padding-top: card.has-cover ? (root.compact ? 10px : 14px) : 0px;
                spacing: 8px;
                if card.title != "": Text {
                    text: card.title;
                    font-size: root.compact ? Type.card-title-compact : Type.card-title;
                    font-weight: 600;
                    letter-spacing: -0.3px;
                    color: root.fg;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if card.title == "": Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 5px;
                    padding-top: 3px;
                    if card.pinned: Icon {
                        y: 1px;
                        width: 13px;
                        height: 13px;
                        path: Icons.pin;
                        color: root.fg-muted;
                        accessible-role: image;
                        accessible-label: "Pinned";
                    }
                    if card.reminder != "": Icon {
                        y: 1px;
                        width: 13px;
                        height: 13px;
                        path: Icons.notification;
                        color: card.reminder-overdue ? Theme.danger : root.fg-muted;
                        accessible-role: image;
                        accessible-label: card.reminder-overdue ? "Overdue reminder" : "Reminder";
                    }
                    Text {
                        text: card.time;
                        horizontal-alignment: right;
                        font-size: Type.meta;
                        font-weight: 500;
                        color: root.fg-muted;
                    }
                }
            }
            VerticalLayout {
                padding-left: root.compact ? 14px : 20px;
                padding-right: root.compact ? 14px : 20px;
                spacing: root.compact ? 6px : 10px;
                if card.preview != "": Text {
                    text: card.preview;
                    font-size: root.compact ? Type.card-body-compact : Type.card-body;
                    color: card.title != "" ? root.fg-secondary : root.fg;
                    wrap: word-wrap;
                }
                for line in card.checklist: HorizontalLayout {
                    spacing: 10px;
                    CheckBox {
                        y: 2px;
                        box: 16px;
                        checked: line.checked;
                        enabled: false;
                        ink: root.cb-bg;
                        border-ink: root.fg-muted;
                        tick-ink: root.cb-tick;
                        label: line.text;
                    }
                    Text {
                        text: line.text;
                        font-size: root.compact ? Type.card-body-compact : Type.card-body;
                        color: line.checked ? root.fg-muted : root.fg-secondary;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                if card.more-items > 0: Text {
                    text: "+" + card.more-items;
                    font-size: Type.meta;
                    font-weight: 600;
                    color: root.fg-muted;
                }
                if card.labels.length > 0 || card.more-labels > 0 || card.reminder != "": HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for name in card.labels: Chip { text: name; fg: root.fg-secondary; bg: root.chip-bg; }
                    if card.more-labels > 0: Chip { text: "+" + card.more-labels; fg: root.fg-secondary; bg: root.chip-bg; }
                    if card.reminder != "": Chip {
                        text: card.reminder;
                        fg: card.reminder-overdue ? Theme.danger : root.fg-secondary;
                        bg: root.chip-bg;
                    }
                }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.focus(); root.clicked(); }
        }
    }
}

component Sidebar inherits Rectangle {
    in property <View> view;
    /// False while a smart view or a saved filter is what is on screen: then that row is current.
    in property <bool> library-current: true;
    in property <int> count-notes;
    in property <int> count-archive;
    in property <int> count-trash;
    in property <[SidebarRow]> views;
    in property <[SidebarRow]> saved;
    in property <bool> collapsed: false;
    // The account area: 0 no sync in this build, 1 guest, 2 signed in.
    in property <int> account-mode;
    in property <string> account-email;
    in property <string> account-initial;
    in property <string> account-status;
    in property <bool> account-problem;
    in property <bool> syncing;
    callback toggle-collapsed();
    callback sign-in();
    callback sync();
    callback sign-out();
    callback view-selected(View);
    callback smart-view(int);
    callback saved-applied(string);
    callback saved-deleted(string);
    callback edit-labels();
    callback open-settings();
    width: root.collapsed ? 72px : Theme.sidebar-width;
    background: Theme.surface;

    // Subtle right divider separating the sidebar surface from the main canvas.
    Rectangle {
        x: parent.width - 1px;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Theme.outline.transparentize(0.45);
    }

    VerticalLayout {
        padding-top: 20px;
        padding-bottom: 14px;
        spacing: 0px;

        // Brand header matching Kotlin MainDrawerContent.kt (BrandMarkIcon + Notelikeus + Capture what matters).
        HorizontalLayout {
            padding-left: root.collapsed ? 16px : 20px;
            padding-right: root.collapsed ? 16px : 16px;
            padding-bottom: 18px;
            spacing: 10px;
            alignment: root.collapsed ? center : start;
            BrandMark {
                y: (parent.height - self.height) / 2;
                size: root.collapsed ? 32px : 36px;
                bg: Theme.on-surface;
                stripe: Theme.surface;
                ring: Theme.on-surface-secondary.transparentize(0.5);
            }
            if !root.collapsed: VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text {
                    text: "Notelikeus";
                    font-size: Type.body-large;
                    font-weight: 700;
                    letter-spacing: -0.3px;
                    color: Theme.on-surface;
                }
                Text {
                    text: "Capture what matters";
                    font-size: Type.meta;
                    color: Theme.on-surface-secondary;
                }
            }
        }

        // Scrolls when many saved filters make it taller than the window.
        nav-scroll := Flickable {
            vertical-stretch: 1;
            content-height: nav.preferred-height;
            nav := VerticalLayout {
                width: nav-scroll.width;
                padding: 10px;
                padding-top: 4px;
                spacing: 4px;
                alignment: start;
                NavItem {
                    icon: Icons.notes;
                    label: "Notes";
                    count: root.count-notes;
                    compact: root.collapsed;
                    selected: root.library-current && root.view == View.notes;
                    clicked => { root.view-selected(View.notes); }
                }
                NavItem {
                    icon: Icons.archive;
                    label: "Archive";
                    count: root.count-archive;
                    compact: root.collapsed;
                    selected: root.library-current && root.view == View.archive;
                    clicked => { root.view-selected(View.archive); }
                }
                NavItem {
                    icon: Icons.trash;
                    label: "Trash";
                    count: root.count-trash;
                    compact: root.collapsed;
                    selected: root.library-current && root.view == View.trash;
                    clicked => { root.view-selected(View.trash); }
                }

                // Smart views, as Kotlin MainDrawerContent's "VIEWS": each is a search, typed into the box when chosen.
                Rectangle { height: root.collapsed ? 10px : 18px; }
                if !root.collapsed: HorizontalLayout { padding-left: 14px; SectionLabel { text: "VIEWS"; } }
                if !root.collapsed: Rectangle { height: 6px; }
                for row[index] in root.views: NavItem {
                    icon: index == 0 ? Icons.notification : index == 1 ? Icons.checklist : Icons.label-off;
                    label: row.label;
                    count: row.count;
                    compact: root.collapsed;
                    selected: row.current;
                    clicked => { root.smart-view(index); }
                }

                // Only when there are any, as the web and Kotlin apps: an empty heading would show a hole.
                if !root.collapsed && root.saved.length > 0: VerticalLayout {
                    spacing: 4px;
                    Rectangle { height: 18px; }
                    HorizontalLayout { padding-left: 14px; SectionLabel { text: "SAVED"; } }
                    Rectangle { height: 6px; }
                    for row in root.saved: HorizontalLayout {
                        spacing: 2px;
                        NavItem {
                            horizontal-stretch: 1;
                            icon: Icons.bookmark;
                            label: row.label;
                            selected: row.current;
                            clicked => { root.saved-applied(row.label); }
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            size: 32px;
                            icon: Icons.close;
                            label: "Delete saved filter " + row.label;
                            clicked => { root.saved-deleted(row.label); }
                        }
                    }
                }

                Rectangle { height: root.collapsed ? 10px : 18px; }
                if !root.collapsed: HorizontalLayout { padding-left: 14px; SectionLabel { text: "MANAGE"; } }
                if !root.collapsed: Rectangle { height: 6px; }
                NavItem {
                    icon: Icons.label;
                    label: "Edit labels";
                    compact: root.collapsed;
                    clicked => { root.edit-labels(); }
                }
                NavItem {
                    icon: Icons.settings;
                    label: "Settings";
                    compact: root.collapsed;
                    clicked => { root.open-settings(); }
                }
            }
        }

        // Collapse button & account footer matching Kotlin MainDrawerContent.kt.
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            spacing: 10px;
            Rectangle { height: 1px; background: Theme.outline.transparentize(0.5); }
            Rectangle {
                height: 40px;
                border-radius: 12px;
                background: collapse-touch.has-hover ? Theme.hover : transparent;
                accessible-role: button;
                accessible-label: root.collapsed ? "Expand sidebar" : "Collapse sidebar";
                accessible-action-default => { root.toggle-collapsed(); }
                HorizontalLayout {
                    padding-left: root.collapsed ? 0px : 14px;
                    padding-right: root.collapsed ? 0px : 12px;
                    spacing: 10px;
                    alignment: root.collapsed ? center : start;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        path: root.collapsed ? Icons.chevron-right : Icons.chevron-left;
                        color: Theme.on-surface-secondary;
                    }
                    if !root.collapsed: Text {
                        text: "Collapse";
                        vertical-alignment: center;
                        font-size: Type.body;
                        font-weight: 500;
                        color: Theme.on-surface-secondary;
                    }
                }
                collapse-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-collapsed(); }
                }
            }

            if root.collapsed && root.account-mode == 1: HorizontalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.person;
                    label: "Sign in";
                    clicked => { root.sign-in(); }
                }
            }
            if root.collapsed && root.account-mode == 2: HorizontalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.sync;
                    label: "Sync now";
                    clicked => { root.sync(); }
                }
            }
            if !root.collapsed && root.account-mode == 0: HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 2px;
                Text {
                    text: "Offline · Notes encrypted on this device";
                    font-size: Type.meta;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
            if !root.collapsed && root.account-mode == 1: Rectangle {
                height: 40px;
                border-radius: 12px;
                background: signin-touch.has-hover ? Theme.on-surface.transparentize(0.10) : Theme.on-surface;
                accessible-role: button;
                accessible-label: "Sign in";
                accessible-action-default => { root.sign-in(); }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        path: Icons.person;
                        color: Theme.surface;
                    }
                    Text {
                        text: "Sign in";
                        vertical-alignment: center;
                        font-size: Type.body;
                        font-weight: 600;
                        color: Theme.surface;
                    }
                }
                signin-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.sign-in(); }
                }
            }
            if !root.collapsed && root.account-mode == 2: VerticalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: Theme.surface-variant;
                        Text {
                            text: root.account-initial;
                            font-size: Type.body;
                            font-weight: 700;
                            color: Theme.on-surface;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.account-email;
                            font-size: Type.body-small;
                            font-weight: 600;
                            color: Theme.on-surface;
                            overflow: elide;
                        }
                        Text {
                            text: root.account-status;
                            font-size: Type.meta;
                            color: root.account-problem ? Theme.danger : Theme.muted;
                            wrap: word-wrap;
                            accessible-role: text;
                            accessible-label: "Sync status: " + root.account-status;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    PillButton {
                        text: root.syncing ? "Syncing…" : "Sync now";
                        label: "Sync now";
                        enabled: !root.syncing;
                        clicked => { root.sync(); }
                    }
                    PillButton {
                        text: "Sign out";
                        clicked => { root.sign-out(); }
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.outline;
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search your notes";
    in property <bool> compact: false;
    callback edited(string);
    forward-focus: input;
    height: 40px;
    border-radius: 12px;
    background: Theme.dark ? Theme.surface-variant.transparentize(0.25) : Theme.surface;
    border-width: input.has-focus ? 1.5px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.outline.transparentize(0.28);

    public function focus-search() {
        input.focus();
        input.select-all();
    }

    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            path: Icons.search;
            color: input.has-focus ? Theme.on-surface : Theme.muted;
        }
        Rectangle {
            horizontal-stretch: 1;
            if input.text == "": Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.compact ? "Search" : root.placeholder;
                overflow: elide;
                font-size: Type.body;
                color: Theme.on-surface-secondary;
                vertical-alignment: center;
            }
            input := TextInput {
                text <=> root.text;
                font-size: Type.body;
                color: Theme.on-surface;
                vertical-alignment: center;
                single-line: true;
                accessible-role: text-input;
                accessible-label: "Search notes";
                edited => { root.edited(self.text); }
            }
        }
        if input.text != "": IconButton {
            y: (parent.height - self.height) / 2;
            size: 26px;
            radius: 7px;
            icon: Icons.close;
            label: "Clear search";
            fg-color: Theme.muted;
            clicked => {
                root.text = "";
                root.edited("");
                input.focus();
            }
        }
        if input.text == "" && !root.compact: Rectangle {
            y: (parent.height - self.height) / 2;
            width: hint.preferred-width + 14px;
            height: 22px;
            border-radius: 6px;
            background: Theme.on-surface.transparentize(0.94);
            border-width: 1px;
            border-color: Theme.outline.transparentize(0.45);
            hint := Text {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: "Ctrl K";
                font-size: Type.meta;
                font-weight: 600;
                color: Theme.on-surface-secondary;
            }
        }
    }
}

/// A plain single-line field with a placeholder, for the dialogs.
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    callback accepted();
    callback edited();
    forward-focus: input;
    height: 40px;
    border-radius: Theme.radius-sm;
    background: Theme.surface-variant;
    border-width: 1px;
    border-color: input.has-focus ? Theme.muted : Theme.outline;
    public function focus-field() { input.focus(); }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Rectangle {
            if input.text == "": Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                font-size: Type.body;
                color: Theme.muted;
                vertical-alignment: center;
            }
            input := TextInput {
                text <=> root.text;
                font-size: Type.body;
                color: Theme.on-surface;
                vertical-alignment: center;
                single-line: true;
                accessible-role: text-input;
                accessible-label: root.label;
                accepted => { root.accepted(); }
                edited => { root.edited(); }
            }
        }
    }
}

/// A dialog card, centred over a scrim. Clicking the scrim does nothing: dialogs close by their buttons.
component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 440px;
    background: Theme.scrim;
    TouchArea { }
    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: max(40px, (parent.height - self.height) / 2);
        width: min(root.card-width, parent.width - 48px);
        height: min(content.preferred-height, parent.height - 80px);
        border-radius: Theme.radius-sheet;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.outline;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000066;
        accessible-role: groupbox;
        accessible-label: root.title;
        content := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Text {
                text: root.title;
                font-size: Type.title;
                font-weight: 700;
                color: Theme.on-surface;
            }
            @children
        }
    }
}

component SettingsWorkspace inherits Rectangle {
    callback back();
    out property <length> content-inset: max(24px, (self.width - Theme.document-width) / 2);
    background: Theme.surface;
    accessible-role: groupbox;
    accessible-label: "Settings page";

    VerticalLayout {
        HorizontalLayout {
            padding: 12px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 10px;
            IconButton {
                size: 36px;
                radius: 8px;
                icon: Icons.back;
                label: "Back from settings";
                clicked => { root.back(); }
                init => { self.focus(); }
            }
            Text {
                text: "Settings";
                font-size: Type.title;
                font-weight: 600;
                color: Theme.on-surface;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        Rectangle { height: 1px; background: Theme.outline.transparentize(0.45); }
        @children
    }
}

component EditorPicture inherits FocusScope {
    in property <Picture> picture;
    in property <int> count;
    callback opened();
    accessible-role: button;
    accessible-label: "Picture " + (root.picture.index + 1) + " of " + root.count;
    accessible-action-default => { root.opened(); }
    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            root.opened();
            return accept;
        }
        reject
    }
    Rectangle {
        border-radius: Theme.radius-md;
        clip: true;
        background: Theme.surface-variant;
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? Theme.accent : Theme.outline.transparentize(0.5);
        if root.picture.ready: Image {
            width: parent.width;
            height: parent.height;
            source: root.picture.image;
            image-fit: contain;
        }
        if !root.picture.ready && root.picture.problem == "": Icon {
            path: Icons.image;
            color: Theme.muted;
        }
        if root.picture.problem != "": Text {
            width: parent.width - 16px;
            text: root.picture.problem;
            font-size: Type.meta;
            color: Theme.muted;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.opened(); }
        }
    }
}

component NoteWorkspace inherits Rectangle {
    in property <View> mode;
    in-out property <bool> reading;
    in-out property <string> title;
    in-out property <string> body;
    in property <bool> pinned;
    in property <bool> reminder-set;
    in property <string> footer;
    in property <bool> can-act;
    in property <bool> has-color;
    in property <color> color-light;
    in property <color> color-dark;
    // The note colour, except under a Windows contrast theme (Theme.note-tint).
    property <bool> tinted: root.has-color && Theme.note-tint;
    in property <[string]> labels;
    in property <bool> is-checklist;
    in property <[EditRow]> rows;
    in property <bool> conflict;
    in property <[Picture]> pictures;
    in property <int> picture-count;
    in property <bool> can-position-pictures;
    in property <[DocumentBlock]> preview;
    in property <int> body-sel-anchor;
    in property <int> body-sel-focus;
    in property <int> body-sel-seq;
    out property <int> body-cursor-byte: body-input.cursor-position-byte-offset;
    out property <int> body-anchor-byte: body-input.anchor-position-byte-offset;
    callback add-image();
    callback open-picture(int);
    callback position-picture(string, int);
    callback unposition-picture(string);
    callback read-requested();
    callback compare();
    callback edited();
    callback close();
    callback open-link(string);
    callback toggle-pin();
    callback archive();
    callback trash();
    callback restore();
    callback delete-forever();
    callback open-options();
    callback open-reminder();
    callback item-edited(int, string);
    callback item-toggled(int);
    callback item-removed(int);
    callback item-added();
    callback to-checklist();
    callback to-text();
    callback format-bold(int, int);
    callback format-italic(int, int);
    callback format-bullet(int, int);
    callback format-link(int, int);
    property <bool> read-only: root.mode == View.trash;
    property <color> fg: Theme.on-surface;
    property <color> fg-secondary: Theme.on-surface-secondary;
    property <color> fg-muted: Theme.muted;
    property <color> chip-bg: Theme.surface-variant;
    property <color> cb-bg: Theme.on-surface;
    property <color> cb-tick: Theme.background;
    property <color> divider: Theme.outline;
    property <length> document-inset: max(24px, (self.width - Theme.document-width) / 2);
    forward-focus: body-input;
    background: Theme.surface;

    changed body-sel-seq => {
        body-input.set-selection-offsets(root.body-sel-anchor, root.body-sel-focus);
        body-input.focus();
    }

    public function focus-title() {
        title-input.focus();
    }

    VerticalLayout {
        // Header: what this note can do where it is.
        HorizontalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 6px;
            back-to-notes := IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                radius: 8px;
                icon: Icons.back;
                label: "Back to notes";
                fg-color: root.fg;
                clicked => { root.close(); }
            }
            if !root.is-checklist && !root.read-only && (root.body != "" || root.reading): PillButton {
                y: (parent.height - self.height) / 2;
                height: 34px;
                text: root.reading ? "Edit note" : "Read note";
                clicked => {
                    if (root.reading) {
                        root.reading = false;
                        body-input.focus();
                    } else { root.read-requested(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.mode != View.trash: IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                radius: 8px;
                icon: Icons.image;
                label: "Add image";
                fg-color: root.fg;
                clicked => { root.add-image(); }
            }
            if root.can-act && root.mode == View.notes: IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                radius: 8px;
                icon: Icons.notification;
                label: root.reminder-set ? "Change reminder" : "Set reminder";
                fg-color: root.fg;
                clicked => { root.open-reminder(); }
            }
            if root.can-act && root.mode != View.trash: IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                radius: 8px;
                icon: Icons.palette;
                label: "Note options";
                fg-color: root.fg;
                clicked => { root.open-options(); }
            }
            if root.can-act && root.mode == View.notes: IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                radius: 8px;
                icon: root.pinned ? Icons.pin-off : Icons.pin;
                label: root.pinned ? "Unpin" : "Pin";
                fg-color: root.fg;
                clicked => { root.toggle-pin(); }
            }
            if root.can-act && root.mode != View.trash: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 1px;
                height: 18px;
                background: root.divider.transparentize(0.35);
            }
            if root.can-act && root.mode != View.trash: IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                radius: 8px;
                icon: root.mode == View.archive ? Icons.unarchive : Icons.archive;
                label: root.mode == View.archive ? "Unarchive note" : "Archive note";
                fg-color: root.fg;
                clicked => { root.archive(); }
            }
            if root.can-act && root.mode != View.trash: IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                radius: 8px;
                icon: Icons.trash;
                label: "Move to trash";
                fg-color: root.fg;
                clicked => { root.trash(); }
            }
            if root.mode == View.trash: IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                radius: 8px;
                icon: Icons.restore;
                label: "Restore";
                fg-color: root.fg;
                clicked => { root.restore(); }
            }
            if root.mode == View.trash: IconButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
                radius: 8px;
                icon: Icons.delete-forever;
                label: "Delete forever";
                fg-color: root.fg;
                clicked => { root.delete-forever(); }
            }
        }
        Rectangle {
            height: root.tinted ? 4px : 1px;
            background: root.tinted ? (Theme.dark ? root.color-dark : root.color-light) : root.divider;
        }

        if root.read-only: Rectangle {
            height: 40px;
            background: Theme.danger.transparentize(0.88);
            Text {
                text: "This note is in the trash. Restore it to edit.";
                font-size: Type.body-small;
                color: root.fg;
            }
        }

        // As the web app's: a copy kept from a sync conflict says so, and offers the comparison.
        if root.conflict && !root.read-only: Rectangle {
            background: Theme.caution-fill.transparentize(0.84);
            HorizontalLayout {
                padding: 10px;
                padding-left: 40px;
                padding-right: 40px;
                spacing: 12px;
                Text {
                    text: "This note was kept from a sync conflict so neither version was lost.";
                    vertical-alignment: center;
                    font-size: Type.body-small;
                    color: root.fg;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                PillButton {
                    y: (parent.height - self.height) / 2;
                    text: "Compare versions";
                    label: "Compare with the current note";
                    clicked => { root.compare(); }
                }
            }
        }

        // Title, labels and body.
        VerticalLayout {
            padding-left: root.document-inset;
            padding-right: root.document-inset;
            padding-top: 24px;
            padding-bottom: 12px;
            spacing: 14px;
            vertical-stretch: 1;

            Rectangle {
                height: max(title-input.preferred-height, 40px);
                if title-input.text == "": Text {
                    x: 0;
                    y: 0;
                    text: "Title";
                    font-size: Type.editor-title;
                    font-weight: 600;
                    color: root.fg-muted;
                }
                title-input := TextInput {
                    y: 0;
                    text <=> root.title;
                    read-only: root.read-only || root.reading;
                    font-size: Type.editor-title;
                    font-weight: 600;
                    letter-spacing: -0.6px;
                    color: root.fg;
                    single-line: false;
                    wrap: word-wrap;
                    accessible-role: text-input;
                    accessible-label: "Title";
                    edited => { root.edited(); }
                    key-pressed(event) => {
                        if (event.text == Key.Return && !root.reading && !root.read-only) {
                            body-input.focus();
                            return accept;
                        }
                        reject
                    }
                }
            }

            if root.labels.length > 0: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for name in root.labels: Chip { text: name; fg: root.fg-secondary; bg: root.chip-bg; }
            }

            // Text mode: Markdown formatting controls, checklist switch, and picture attachment.
            if !root.is-checklist && !root.read-only && !root.reading: HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: 38px;
                    width: tools.preferred-width;
                    border-radius: 10px;
                    background: Theme.dark ? Theme.surface-variant : Theme.surface;
                    border-width: 1px;
                    border-color: root.divider.transparentize(0.25);
                    drop-shadow-blur: 8px;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-color: #00000014;
                    tools := HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;
                        IconButton {
                            size: 30px;
                            radius: 7px;
                            focus-on-click: false;
                            fg-color: root.fg;
                            icon: Icons.bold;
                            label: "Bold";
                            clicked => {
                                root.format-bold(body-input.anchor-position-byte-offset, body-input.cursor-position-byte-offset);
                            }
                        }
                        IconButton {
                            size: 30px;
                            radius: 7px;
                            focus-on-click: false;
                            fg-color: root.fg;
                            icon: Icons.italic;
                            label: "Italic";
                            clicked => {
                                root.format-italic(body-input.anchor-position-byte-offset, body-input.cursor-position-byte-offset);
                            }
                        }
                        IconButton {
                            size: 30px;
                            radius: 7px;
                            focus-on-click: false;
                            fg-color: root.fg;
                            icon: Icons.link;
                            label: "Insert link";
                            clicked => {
                                root.format-link(body-input.anchor-position-byte-offset, body-input.cursor-position-byte-offset);
                            }
                        }
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 1px;
                            height: 16px;
                            background: root.divider.transparentize(0.25);
                        }
                        IconButton {
                            size: 30px;
                            radius: 7px;
                            focus-on-click: false;
                            fg-color: root.fg;
                            icon: Icons.bullet-list;
                            label: "Bullet list";
                            clicked => {
                                root.format-bullet(body-input.anchor-position-byte-offset, body-input.cursor-position-byte-offset);
                            }
                        }
                        IconButton {
                            size: 30px;
                            radius: 7px;
                            fg-color: root.fg;
                            icon: Icons.checklist;
                            label: "Make a checklist";
                            clicked => { root.to-checklist(); }
                        }
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 1px;
                            height: 16px;
                            background: root.divider.transparentize(0.25);
                        }
                        IconButton {
                            size: 30px;
                            radius: 7px;
                            fg-color: root.fg;
                            icon: Icons.image;
                            label: "Add image from toolbar";
                            clicked => { root.add-image(); }
                        }
                    }
                }
            }

            if root.reading && !root.is-checklist: preview-scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: preview-column.preferred-height;
                preview-column := VerticalLayout {
                    width: preview-scroll.visible-width;
                    spacing: 16px;
                    padding-bottom: 16px;
                    for block in root.preview: HorizontalLayout {
                        spacing: 10px;
                        for level in block.quote-depth: Rectangle {
                            width: 3px;
                            border-radius: 1.5px;
                            background: Theme.muted.transparentize(0.35);
                            vertical-stretch: 1;
                        }
                        VerticalLayout {
                            if block.kind == DocumentKind.divider: Rectangle {
                                height: 1px;
                                background: Theme.outline;
                                accessible-role: text;
                                accessible-label: block.description;
                            }
                            if block.kind == DocumentKind.picture: HorizontalLayout {
                                alignment: start;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 4px;
                                    EditorPicture {
                                        picture: block.picture;
                                        count: root.picture-count;
                                        width: min(preview-column.width, min(540px, max(100px, 280px * block.picture.aspect)));
                                        height: min(280px, self.width / max(0.01, block.picture.aspect));
                                        opened => { root.open-picture(block.picture.index); }
                                    }
                                    if root.can-position-pictures && !root.read-only: HorizontalLayout {
                                        alignment: start;
                                        PillButton {
                                            text: "Move to attachment strip";
                                            clicked => {
                                                root.unposition-picture(block.picture.id);
                                                back-to-notes.focus();
                                            }
                                        }
                                    }
                                }
                            }
                            if block.kind == DocumentKind.prose || block.kind == DocumentKind.code: Rectangle {
                                background: block.kind == DocumentKind.code ? Theme.surface-variant : transparent;
                                border-color: Theme.outline;
                                border-width: block.kind == DocumentKind.code ? 1px : 0px;
                                border-radius: Theme.radius-sm;
                                VerticalLayout {
                                    padding: block.kind == DocumentKind.code ? 12px : 0px;
                                    StyledText {
                                        text: block.text;
                                        accessible-role: text;
                                        accessible-label: block.description;
                                        default-color: block.kind == DocumentKind.code ? Theme.on-surface : root.fg;
                                        default-font-family: block.kind == DocumentKind.code ? "Consolas" : "Inter";
                                        default-font-size: block.heading == 0 ? Type.editor-body
                                            : block.heading == 1 ? Type.heading-large
                                            : block.heading == 2 ? Type.heading-medium : Type.title;
                                        link-color: Theme.accent;
                                        selectable: true;
                                        link-clicked(url) => { root.open-link(url); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Keep the input mounted when reading so its selection survives a mode change.
            body-scroll := Flickable {
                vertical-stretch: root.is-checklist || root.reading ? 0 : 1;
                max-height: root.is-checklist || root.reading ? 0px : 100000px;
                visible: !root.is-checklist && !root.reading;
                content-height: max(self.height, body-input.preferred-height + 24px);
                if body-input.text == "": Text {
                    x: 0;
                    y: 0;
                    text: root.read-only ? "" : "Start writing…";
                    font-size: Type.editor-body;
                    color: root.fg-muted;
                }
                body-input := TextInput {
                    width: body-scroll.width;
                    text <=> root.body;
                    read-only: root.read-only;
                    font-size: Type.editor-body;
                    color: root.fg;
                    single-line: false;
                    wrap: word-wrap;
                    accessible-role: text-input;
                    accessible-label: "Note";
                    edited => { root.edited(); }
                    key-pressed(event) => {
                        if (!root.read-only && event.modifiers.control) {
                            if (event.text == "b" || event.text == "B") {
                                root.format-bold(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                                return accept;
                            }
                            if (event.text == "i" || event.text == "I") {
                                root.format-italic(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                                return accept;
                            }
                        }
                        reject
                    }
                    // Keep the caret in view as the note grows past the sheet.
                    cursor-position-changed(position) => {
                        if (position.y + 40px > body-scroll.height - body-scroll.content-y) {
                            body-scroll.content-y = min(0px, body-scroll.height - position.y - 40px);
                        } else if (position.y < -body-scroll.content-y) {
                            body-scroll.content-y = -position.y;
                        }
                    }
                }
            }

            // Checklist mode: unticked items first, as the web app sorts them.
            if root.is-checklist: list-scroll := Flickable {
                vertical-stretch: 1;
                content-height: max(self.height, list.preferred-height + 24px);
                list := VerticalLayout {
                    width: list-scroll.width;
                    alignment: start;
                    spacing: 6px;
                    for row in root.rows: HorizontalLayout {
                        spacing: 12px;
                        CheckBox {
                            y: 4px;
                            checked: row.checked;
                            enabled: !root.read-only;
                            ink: root.cb-bg;
                            border-ink: root.fg-muted;
                            tick-ink: root.cb-tick;
                            label: row.text != "" ? row.text : "Checklist item";
                            toggled => { root.item-toggled(row.position); }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            // The text sits 3px down so its first line is centred on the 28px checkbox row.
                            height: max(item-input.preferred-height + 3px, 28px);
                            if item-input.text == "": Text {
                                x: 0;
                                y: 3px;
                                text: "List item";
                                font-size: Type.editor-body;
                                color: root.fg-muted;
                            }
                            item-input := TextInput {
                                y: 3px;
                                text: row.text;
                                read-only: root.read-only;
                                font-size: Type.editor-body;
                                color: row.checked ? root.fg-muted : root.fg;
                                single-line: false;
                                wrap: word-wrap;
                                accessible-role: text-input;
                                accessible-label: row.text != "" ? "Edit " + row.text : "Edit empty item";
                                edited => { root.item-edited(row.position, self.text); }
                                key-pressed(event) => {
                                    if (!root.read-only && event.text == Key.Return) {
                                        root.item-added();
                                        return accept;
                                    }
                                    reject
                                }
                                init => {
                                    if (row.focus) {
                                        self.focus();
                                    }
                                }
                            }
                        }
                        if !root.read-only: IconButton {
                            size: 28px;
                            fg-color: root.fg;
                            icon: Icons.close;
                            label: row.text != "" ? "Remove " + row.text : "Remove empty item";
                            clicked => { root.item-removed(row.position); }
                        }
                    }
                    if !root.read-only: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        padding-top: 6px;
                        PillButton {
                            text: "+ List item";
                            clicked => { root.item-added(); }
                        }
                        PillButton {
                            text: "Convert to text";
                            clicked => { root.to-text(); }
                        }
                    }
                }
            }
            // Attachments follow the body and open in the full-window viewer.
            if root.pictures.length > 0: strip := Flickable {
                property <bool> position-actions: !root.reading && !root.is-checklist && !root.read-only
                    && root.can-position-pictures && root.body != "";
                property <length> picture-height: position-actions ? min(112px, root.height / 5)
                    : min(136px, root.height / 4);
                height: picture-height + (position-actions ? 44px : 0px);
                vertical-stretch: 0;
                content-width: strip-row.preferred-width;
                strip-row := HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    for picture in root.pictures: VerticalLayout {
                        alignment: start;
                        spacing: 6px;
                        EditorPicture {
                            width: min(320px, max(48px, strip.picture-height * picture.aspect));
                            height: strip.picture-height;
                            picture: picture;
                            count: root.picture-count;
                            opened => { root.open-picture(picture.index); }
                        }
                        if strip.position-actions: PillButton {
                            text: "Place after cursor paragraph";
                            label: self.text + " for picture " + (picture.index + 1);
                            clicked => {
                                root.position-picture(picture.id, body-input.cursor-position-byte-offset);
                                if (root.reading) { back-to-notes.focus(); }
                            }
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: root.divider.transparentize(0.45); }
        HorizontalLayout {
            padding-top: 11px;
            padding-bottom: 11px;
            padding-left: root.document-inset;
            padding-right: root.document-inset;
            Text {
                text: root.footer;
                font-size: Type.meta;
                font-weight: 500;
                color: root.fg-muted;
                accessible-role: text;
                accessible-label: "Save status";
            }
        }
    }
}

export component AppWindow inherits Window {
    in-out property <int> theme-mode <=> Theme.mode;
    in-out property <int> theme-accent <=> Theme.accent-mode;
    in-out property <bool> theme-amoled <=> Theme.amoled;
    in-out property <bool> sidebar-collapsed: false;
    in-out property <int> sort-order: 0; // 0 manual, 1 newest, 2 oldest.
    in-out property <int> view-density: 0; // 0 grid, 1 list, 2 compact.

    title: "Notelikeus";
    icon: @image-url("images/icon.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 640px;
    min-height: 480px;
    background: Theme.background;
    default-font-family: "Inter";

    // The view and its notes, from Rust.
    in-out property <View> view: View.notes;
    in property <[CardColumn]> pinned-columns;
    in property <[CardColumn]> columns;
    in property <bool> has-pinned-section: false;
    in property <bool> has-other-section: false;
    in property <int> note-count;
    in property <int> count-notes;
    in property <int> count-archive;
    in property <int> count-trash;
    in property <bool> searching;
    in-out property <string> query;

    // Smart views and saved filters in the sidebar; under the search box, what the search could not use.
    in property <bool> library-current: true;
    in property <[SidebarRow]> smart-views;
    in property <[SidebarRow]> saved-filters;
    in property <string> notice-ignored;
    in property <string> notice-fuzzy;

    // The account and sync (see Sidebar for account-mode).
    in property <int> account-mode;
    in property <string> account-email;
    in property <string> account-initial;
    in property <string> account-status;
    in property <bool> account-problem;
    in property <bool> uploads-blocked-after-wipe: false;
    in property <bool> syncing;
    in property <string> app-version;

    // Settings, diagnostics, About and account deletion.
    in-out property <bool> settings-open;
    in-out property <bool> about-open;
    in-out property <bool> diagnostics-open;
    in property <string> diagnostics-report;
    in-out property <bool> delete-account-open;
    in-out property <string> delete-account-confirmation;
    in property <bool> can-delete-account;
    in property <bool> deleting-account;

    // Signing in: step 0 email, 1 the browser's security check, 2 the code.
    in-out property <bool> signin-open;
    in property <int> signin-step;
    in-out property <string> signin-email;
    in-out property <string> signin-code;
    in property <string> signin-error;
    in property <string> signin-notice;
    in property <bool> signin-busy;
    in property <int> signin-resend-in;

    // The open note's pictures, and the viewer.
    in property <[Picture]> editor-pictures;
    in property <[Picture]> editor-unplaced-pictures;
    in property <string> editor-picture-body;
    in-out property <bool> viewer-open;
    in property <Picture> viewer-picture;
    in property <int> viewer-index;
    in-out property <int> viewer-zoom-index;
    property <[float]> viewer-zoom-levels: [1, 1.5, 2, 3, 4];
    property <float> viewer-zoom: root.viewer-zoom-levels[root.viewer-zoom-index];
    in property <int> viewer-count;
    in property <bool> viewer-read-only;

    // A copy kept from a sync conflict, beside the note it was split from.
    in property <bool> editor-conflict;
    in-out property <bool> review-open;
    in property <bool> review-has-original;
    in property <string> review-original-title;
    in property <string> review-original-edited;
    in property <[ReviewRow]> review-original-lines;
    in property <string> review-copy-title;
    in property <string> review-copy-edited;
    in property <[ReviewRow]> review-copy-lines;

    // The Filters sheet.
    in-out property <bool> filters-open;
    in property <bool> filters-active;
    in property <int> filter-count;
    in property <[bool]> filter-colors;
    in property <[ChoiceRow]> filter-label-rows;
    in property <int> filter-label-count;
    in property <bool> filter-label-all;
    in property <[ChoiceRow]> filter-flag-rows;
    in property <[Choice]> filter-date-fields;
    in property <[Choice]> filter-presets;
    in-out property <bool> naming;
    in-out property <string> filter-name;
    in property <string> filter-name-hint;

    // The editor.
    in-out property <bool> editor-open;
    in-out property <bool> editor-reading;
    in property <View> editor-mode;
    in-out property <string> editor-title;
    in-out property <string> editor-body;
    in property <bool> editor-pinned;
    in property <bool> editor-reminder-set;
    in property <bool> editor-saved-once;
    in property <string> editor-footer;
    in property <bool> editor-has-color;
    in property <color> editor-color-light;
    in property <color> editor-color-dark;
    in property <[string]> editor-labels;
    in property <bool> editor-is-checklist;
    in property <[EditRow]> editor-rows;
    in-out property <int> editor-body-sel-anchor;
    in-out property <int> editor-body-sel-focus;
    in-out property <int> editor-body-sel-seq;
    in-out property <bool> reminder-open;
    in-out property <string> reminder-input;
    in property <string> reminder-error;
    in property <bool> reminder-set;

    // Insert Link dialog.
    in-out property <bool> link-dialog-open: false;
    in-out property <string> link-label-text;
    in-out property <string> link-url-text;
    in property <string> link-error;

    // Note options: colour and labels.
    in-out property <bool> options-open;
    in property <[Swatch]> swatches;
    in property <int> editor-color-index;
    in property <[LabelChoice]> label-choices;
    in-out property <string> new-label;

    // Edit labels.
    in-out property <bool> labels-open;
    in property <[string]> all-labels;
    in-out property <string> labels-new;

    // A confirmation (empty trash, delete forever).
    in property <string> confirm-title;
    in property <string> confirm-body;
    in property <string> confirm-action;

    // A short message with an optional action (Undo).
    in property <string> toast-text;
    in property <string> toast-action;

    property <bool> any-modal-open: root.editor-open || root.filters-open || root.viewer-open || root.signin-open
        || root.review-open || root.options-open || root.reminder-open || root.labels-open || root.naming
        || root.settings-open || root.diagnostics-open || root.about-open || root.delete-account-open
        || root.link-dialog-open || root.confirm-title != "";

    property <length> min-card-w: root.view-density == 2 ? 230px : Theme.card-min-width;
    // How many card columns fit; Rust lays the cards out into that many.
    out property <int> column-count: root.view-density == 1
        ? 1
        : max(1, min(root.view-density == 2 ? 5 : 4, floor((scroll.visible-width - 48px + Theme.note-gap) / (root.min-card-w + Theme.note-gap))));
    // Every column the same width, whatever its cards say.
    property <length> column-width: root.view-density == 1
        ? min(960px, max(200px, scroll.visible-width - 48px))
        : (scroll.visible-width - 48px - (root.column-count - 1) * Theme.note-gap) / root.column-count;

    callback columns-changed(int);
    callback view-selected(View);
    callback query-edited(string);
    callback smart-view-picked(int);
    callback saved-applied(string);
    callback saved-deleted(string);
    callback filter-color-toggled(int);
    callback filter-label-toggled(string);
    callback filter-label-match-toggled();
    callback filter-flag-toggled(int);
    callback filter-date-field-picked(int);
    callback filter-preset-picked(int);
    callback filters-cleared();
    callback filter-name-edited(string);
    callback filter-saved(string);
    callback sync-requested();
    callback sign-out-requested();
    callback settings-requested();
    callback theme-picked(int);
    callback accent-picked(int);
    callback amoled-toggled();
    callback sidebar-toggled();
    callback sort-picked(int);
    callback density-picked(int);
    callback reupload-after-wipe-requested();
    callback delete-cloud-data-requested();
    callback diagnostics-requested();
    callback diagnostics-copied();
    callback diagnostics-export-requested();
    callback delete-account-opened();
    callback delete-account-confirmed();
    callback backup-export-json-requested();
    callback backup-export-bundle-requested();
    callback backup-import-requested();
    callback signin-opened();
    callback signin-send();
    callback signin-resend();
    callback signin-verify();
    callback signin-change-email();
    callback signin-cancelled();
    callback review-opened();
    callback review-keep-original();
    callback review-keep-copy();
    callback review-keep-both();
    callback image-add-requested();
    callback picture-opened(int);
    callback picture-positioned(string, int);
    callback picture-unpositioned(string);
    callback read-requested();
    callback viewer-moved(int);
    callback picture-remove-requested();
    callback open-reminder();
    callback reminder-preset(int);
    callback reminder-save();
    callback reminder-remove();
    callback reminder-cancel();
    callback reminder-due();
    // Raised by Rust: timers and the worker thread.
    callback sync-due();
    callback resend-tick();
    callback background-done();
    callback new-note();
    callback open-note(string);
    callback editor-edited();
    callback close-editor();
    pure callback render-preview(string, [Picture]) -> [DocumentBlock];
    callback open-preview-link(string);
    callback toggle-pin();
    callback archive-toggled();
    callback trash-note();
    callback restore-note();
    callback delete-forever();
    callback empty-trash();
    callback open-options();
    callback color-picked(int, bool);
    callback label-toggled(string);
    callback label-created(string);
    callback item-edited(int, string);
    callback item-toggled(int);
    callback item-removed(int);
    callback item-added();
    callback to-checklist();
    callback to-text();
    callback format-bold(int, int);
    callback format-italic(int, int);
    callback format-bullet(int, int);
    callback open-link-dialog(int, int);
    callback insert-link-submitted();
    callback open-labels();
    callback label-renamed(string, string);
    callback label-deleted(string);
    callback labels-created(string);
    callback confirm-accepted();
    callback confirm-cancelled();
    callback toast-acted();
    // Raised by Rust timers, so their closures never hold the controller.
    callback autosave-due();
    callback toast-expired();

    changed column-count => { root.columns-changed(self.column-count); }
    changed diagnostics-open => { if (!self.diagnostics-open) { keys.focus(); } }
    changed about-open => { if (!self.about-open) { keys.focus(); } }
    changed delete-account-open => { if (!self.delete-account-open) { keys.focus(); } }
    changed settings-open => { if (!self.settings-open) { keys.focus(); } }
    changed signin-open => { if (!self.signin-open) { keys.focus(); } }
    changed review-open => { if (!self.review-open) { keys.focus(); } }
    changed link-dialog-open => { if (!self.link-dialog-open) { keys.focus(); } }
    changed reminder-open => { if (!self.reminder-open) { keys.focus(); } }
    changed options-open => { if (!self.options-open) { keys.focus(); } }
    changed labels-open => { if (!self.labels-open) { keys.focus(); } }
    changed filters-open => { if (!self.filters-open) { keys.focus(); } }
    changed viewer-open => {
        if (!self.viewer-open) {
            self.viewer-zoom-index = 0;
            keys.focus();
        }
    }
    changed confirm-title => { if (self.confirm-title == "") { keys.focus(); } }

    public function focus-search() {
        search.focus-search();
    }

    // Back to the window after the editor closes, so the shortcuts keep working.
    public function focus-main() {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (!root.any-modal-open && event.modifiers.control && (event.text == "n" || event.text == "N")) {
                root.new-note();
                return accept;
            }
            if (!root.any-modal-open && event.modifiers.control && (event.text == "k" || event.text == "K" || event.text == "f" || event.text == "F")) {
                search.focus-search();
                return accept;
            }
            if (root.viewer-open && root.confirm-title == ""
                && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                root.viewer-moved(event.text == Key.LeftArrow ? -1 : 1);
                return accept;
            }
            if (root.viewer-open && root.viewer-picture.ready && root.confirm-title == ""
                && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                if (event.text == "+" || event.text == "=") {
                    root.viewer-zoom-index = min(4, root.viewer-zoom-index + 1);
                    return accept;
                }
                if (event.text == "-") {
                    root.viewer-zoom-index = max(0, root.viewer-zoom-index - 1);
                    return accept;
                }
                if (event.text == "0") {
                    root.viewer-zoom-index = 0;
                    return accept;
                }
            }
            if (event.text == Key.Escape) {
                if (root.confirm-title != "") {
                    root.confirm-cancelled();
                } else if (root.viewer-open) {
                    root.viewer-open = false;
                } else if (root.link-dialog-open) {
                    root.link-dialog-open = false;
                } else if (root.review-open) {
                    root.review-open = false;
                } else if (root.signin-open) {
                    root.signin-cancelled();
                } else if (root.diagnostics-open) {
                    root.diagnostics-open = false;
                } else if (root.about-open) {
                    root.about-open = false;
                } else if (root.delete-account-open) {
                    root.delete-account-open = false;
                    root.delete-account-confirmation = "";
                } else if (root.settings-open) {
                    root.settings-open = false;
                } else if (root.reminder-open) {
                    root.reminder-cancel();
                } else if (root.options-open) {
                    root.options-open = false;
                } else if (root.labels-open) {
                    root.labels-open = false;
                } else if (root.naming) {
                    root.naming = false;
                } else if (root.filters-open) {
                    root.filters-open = false;
                } else if (root.editor-open) {
                    root.close-editor();
                }
                return accept;
            }
            reject
        }

        HorizontalLayout {
            visible: !root.editor-open && !root.settings-open;
            Sidebar {
                view: root.view;
                library-current: root.library-current;
                count-notes: root.count-notes;
                count-archive: root.count-archive;
                count-trash: root.count-trash;
                views: root.smart-views;
                saved: root.saved-filters;
                collapsed: root.sidebar-collapsed;
                account-mode: root.account-mode;
                account-email: root.account-email;
                account-initial: root.account-initial;
                account-status: root.account-status;
                account-problem: root.account-problem;
                syncing: root.syncing;
                toggle-collapsed => { root.sidebar-toggled(); }
                sign-in => { root.signin-opened(); }
                sync => { root.sync-requested(); }
                sign-out => { root.sign-out-requested(); }
                view-selected(view) => { root.view-selected(view); }
                smart-view(index) => { root.smart-view-picked(index); }
                saved-applied(name) => { root.saved-applied(name); }
                saved-deleted(name) => { root.saved-deleted(name); }
                edit-labels => { root.open-labels(); }
                open-settings => { root.settings-requested(); }
            }

            VerticalLayout {
                horizontal-stretch: 1;

                // Modern unified top command bar: 40px Search + 40px Segmented View Toggle + 40px Account button.
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 14px;
                    padding-bottom: 10px;
                    spacing: 10px;
                    search := SearchField {
                        horizontal-stretch: 1;
                        compact: root.width < 820px;
                        placeholder: root.view == View.archive ? "Search archive"
                            : root.view == View.trash ? "Search trash"
                            : "Search your notes";
                        text <=> root.query;
                        edited(text) => { root.query-edited(text); }
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 40px;
                        width: density-seg.preferred-width;
                        border-radius: 12px;
                        background: Theme.dark ? Theme.surface-variant.transparentize(0.25) : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.outline.transparentize(0.28);
                        density-seg := HorizontalLayout {
                            padding: 4px;
                            spacing: 2px;
                            IconButton {
                                size: 32px;
                                radius: 8px;
                                icon: Icons.list-view;
                                label: "List view";
                                filled: root.view-density == 1;
                                fg-color: root.view-density == 1 ? Theme.background : Theme.on-surface-secondary;
                                clicked => { root.density-picked(1); }
                            }
                            IconButton {
                                size: 32px;
                                radius: 8px;
                                icon: Icons.grid-view;
                                label: "Grid view";
                                filled: root.view-density == 0;
                                fg-color: root.view-density == 0 ? Theme.background : Theme.on-surface-secondary;
                                clicked => { root.density-picked(0); }
                            }
                            IconButton {
                                size: 32px;
                                radius: 8px;
                                icon: Icons.compact-view;
                                label: "Compact view";
                                filled: root.view-density == 2;
                                fg-color: root.view-density == 2 ? Theme.background : Theme.on-surface-secondary;
                                clicked => { root.density-picked(2); }
                            }
                        }
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: avatar-touch.has-hover ? Theme.hover : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.outline.transparentize(0.28);
                        accessible-role: button;
                        accessible-label: root.account-mode == 1 ? "Sign in to sync" : "Open account and settings";
                        accessible-action-default => {
                            if (root.account-mode == 1) { root.signin-opened(); }
                            else { root.settings-requested(); }
                        }
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: Theme.on-surface.transparentize(0.86);
                            if root.account-mode == 2 && root.account-initial != "": Text {
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                text: root.account-initial;
                                font-size: Type.body-small;
                                font-weight: 700;
                                color: Theme.on-surface;
                            }
                            if root.account-mode != 2 || root.account-initial == "": Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 16px;
                                height: 16px;
                                path: Icons.person;
                                color: Theme.on-surface;
                            }
                        }
                        avatar-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.account-mode == 1) { root.signin-opened(); }
                                else { root.settings-requested(); }
                            }
                        }
                    }
                }

                // Modern filter & segmented sort strip.
                // In a Flickable so the row scrolls sideways when the notes area is narrower than it, as on
                // Android, instead of forcing its width onto the window.
                VerticalLayout {
                    padding-bottom: 12px;
                    Flickable {
                        height: filter-row.preferred-height;
                        content-width: max(self.width, filter-row.preferred-width);
                        content-height: self.height;
                        filter-row := HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            spacing: 10px;
                            alignment: start;
                            PillButton {
                                y: (parent.height - self.height) / 2;
                                height: 32px;
                                strong: root.filter-count > 0;
                                text: root.filter-count > 0 ? "Filters · " + root.filter-count : "Filters";
                                label: "Filters";
                                icon: Icons.filter;
                                clicked => { root.filters-open = true; }
                            }
                            if root.filters-active: PillButton {
                                y: (parent.height - self.height) / 2;
                                height: 32px;
                                text: "Clear filters";
                                clicked => { root.filters-cleared(); }
                            }
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 1px;
                                height: 18px;
                                background: Theme.outline.transparentize(0.35);
                            }
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 32px;
                                width: sort-seg.preferred-width;
                                border-radius: 10px;
                                background: Theme.dark ? Theme.surface-variant.transparentize(0.35) : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.outline.transparentize(0.35);
                                sort-seg := HorizontalLayout {
                                    padding: 3px;
                                    spacing: 2px;
                                    SegmentTab {
                                        text: "Manual";
                                        on: root.sort-order == 0;
                                        clicked => { root.sort-picked(0); }
                                    }
                                    SegmentTab {
                                        text: "Newest";
                                        on: root.sort-order == 1;
                                        clicked => { root.sort-picked(1); }
                                    }
                                    SegmentTab {
                                        text: "Oldest";
                                        on: root.sort-order == 2;
                                        clicked => { root.sort-picked(2); }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.outline.transparentize(0.55);
                }

                // What the search could not use, and near matches, said rather than left to look like a match.
                if root.notice-ignored != "": HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 24px;
                    padding-bottom: 8px;
                    Text {
                        text: root.notice-ignored;
                        font-size: Type.body-small;
                        color: Theme.muted;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                }
                if root.notice-fuzzy != "" && root.note-count > 0: HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 24px;
                    padding-bottom: 8px;
                    Text {
                        text: root.notice-fuzzy;
                        font-size: Type.body-small;
                        color: Theme.muted;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                }

                // Cloud-wipe caution banner when another device erased cloud data.
                if root.uploads-blocked-after-wipe && root.account-mode == 2: Rectangle {
                    background: Theme.caution-fill.transparentize(0.84);
                    HorizontalLayout {
                        padding: 12px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 12px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            path: Icons.warning;
                            color: Theme.on-surface;
                        }
                        Text {
                            text: "Cloud notes were wiped from another device. Local notes remain safe on this device while cloud uploads are paused.";
                            vertical-alignment: center;
                            font-size: Type.body-small;
                            color: Theme.on-surface;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            accessible-role: text;
                            accessible-label: self.text;
                        }
                        PillButton {
                            y: (parent.height - self.height) / 2;
                            text: "Re-upload local notes";
                            strong: true;
                            clicked => { root.reupload-after-wipe-requested(); }
                        }
                    }
                }

                // The trash's banner, as the web app's.
                if root.view == View.trash && root.count-trash > 0: Rectangle {
                    height: 56px;
                    background: Theme.danger.transparentize(0.9);
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 16px;
                        Text {
                            text: "Notes in trash are removed permanently when you empty trash.";
                            vertical-alignment: center;
                            font-size: Type.body-small;
                            color: Theme.on-surface;
                            horizontal-stretch: 1;
                        }
                        PillButton {
                            y: (parent.height - self.height) / 2;
                            text: "Empty trash";
                            danger: true;
                            clicked => { root.empty-trash(); }
                        }
                    }
                }

                // The grid, or what to say when there is nothing in it.
                Rectangle {
                    vertical-stretch: 1;
                    scroll := ScrollView {
                        visible: root.note-count > 0;
                        content-width: self.visible-width;
                        content-height: grid-wrap.preferred-height;
                        grid-wrap := VerticalLayout {
                            width: scroll.visible-width;
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 8px;
                            padding-bottom: 88px;
                            spacing: 16px;
                            alignment: start;

                            if root.has-pinned-section: VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    alignment: start;
                                    Rectangle {
                                        width: 120px;
                                        height: pinned-section-hdr.preferred-height;
                                        pinned-section-hdr := SectionLabel {
                                            x: 0;
                                            text: "PINNED";
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: Theme.note-gap;
                                    for column in root.pinned-columns: VerticalLayout {
                                        alignment: start;
                                        spacing: Theme.note-gap;
                                        width: root.column-width;
                                        for card in column.cards: Card {
                                            card: card;
                                            compact: root.view-density == 2;
                                            clicked => { root.open-note(card.id); }
                                        }
                                    }
                                }
                            }

                            if root.has-pinned-section && root.has-other-section: HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 120px;
                                    height: other-section-hdr.preferred-height;
                                    other-section-hdr := SectionLabel {
                                        x: 0;
                                        text: "OTHERS";
                                    }
                                }
                            }

                            if root.has-other-section: HorizontalLayout {
                                alignment: start;
                                spacing: Theme.note-gap;
                                for column in root.columns: VerticalLayout {
                                    alignment: start;
                                    spacing: Theme.note-gap;
                                    width: root.column-width;
                                    for card in column.cards: Card {
                                        card: card;
                                        compact: root.view-density == 2;
                                        clicked => { root.open-note(card.id); }
                                    }
                                }
                            }
                        }
                    }
                    if root.note-count == 0: VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            if !root.searching && root.view == View.notes: BrandMark {
                                size: 72px;
                                opacity: 0.25;
                                bg: Theme.on-surface;
                                stripe: Theme.surface;
                                ring: Theme.on-surface-secondary.transparentize(0.5);
                            }
                            if root.searching || root.view != View.notes: Rectangle {
                                width: 64px;
                                height: 64px;
                                border-radius: 32px;
                                background: Theme.surface-variant;
                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 28px;
                                    height: 28px;
                                    path: root.searching ? Icons.filter
                                        : root.view == View.archive ? Icons.archive
                                        : Icons.trash;
                                    color: Theme.muted;
                                }
                            }
                        }
                        Text {
                            text: root.searching ? "No notes match your search"
                                : root.view == View.archive ? "Archive is empty"
                                : root.view == View.trash ? "Trash is empty"
                                : "Notes you add appear here";
                            horizontal-alignment: center;
                            font-size: Type.title;
                            font-weight: 600;
                            color: Theme.on-surface;
                        }
                        Text {
                            text: root.searching ? "Try other words, or clear the filters."
                                : root.view == View.archive ? "Notes you archive appear here."
                                : root.view == View.trash ? "Notes you move to the trash appear here."
                                : "Press Ctrl+N, or the + button, to write one.";
                            horizontal-alignment: center;
                            font-size: Type.body;
                            color: Theme.on-surface-secondary;
                        }
                        if root.searching: HorizontalLayout {
                            alignment: center;
                            PillButton {
                                text: "Clear filters";
                                strong: true;
                                clicked => { root.filters-cleared(); }
                            }
                        }
                        if !root.searching && root.view == View.notes: HorizontalLayout {
                            alignment: center;
                            PillButton {
                                text: "Write a note";
                                label: "Write a note";
                                strong: true;
                                clicked => { root.new-note(); }
                            }
                        }
                    }
                    // Bottom-right Floating Action Button matching Kotlin MainScaffold.kt (`shape = MaterialTheme.shapes.large`, 56x56 rounded square).
                    if root.view == View.notes: fab-wrap := FocusScope {
                        x: parent.width - self.width - 28px;
                        y: parent.height - self.height - 28px;
                        width: 56px;
                        height: 56px;
                        accessible-role: button;
                        accessible-label: "New note";
                        accessible-action-default => { root.new-note(); }
                        key-pressed(event) => {
                            if (event.text == Key.Space || event.text == Key.Return) {
                                root.new-note();
                                return accept;
                            }
                            reject
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 16px;
                            background: fab-touch.has-hover ? Theme.on-surface.transparentize(0.08) : Theme.on-surface;
                            border-width: fab-wrap.has-focus ? 2px : 0px;
                            border-color: Theme.accent;
                            drop-shadow-blur: 18px;
                            drop-shadow-color: #00000055;
                            Icon {
                                width: 24px;
                                height: 24px;
                                path: Icons.add;
                                color: Theme.background;
                            }
                            fab-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { fab-wrap.focus(); root.new-note(); }
                            }
                        }
                    }
                }
            }
        }

        // --- Overlays in strict bottom-to-top Z-order ---

        // 1. Note workspace
        if root.editor-open: NoteWorkspace {
            mode: root.editor-mode;
            reading <=> root.editor-reading;
            preview: root.editor-reading && !root.editor-is-checklist ? root.render-preview(
                root.editor-body, root.editor-picture-body == root.editor-body ? root.editor-pictures : []) : [];
            title <=> root.editor-title;
            body <=> root.editor-body;
            pinned: root.editor-pinned;
            reminder-set: root.editor-reminder-set;
            footer: root.editor-footer;
            can-act: root.editor-saved-once;
            has-color: root.editor-has-color;
            color-light: root.editor-color-light;
            color-dark: root.editor-color-dark;
            labels: root.editor-labels;
            is-checklist: root.editor-is-checklist;
            rows: root.editor-rows;
            conflict: root.editor-conflict;
            pictures: root.editor-reading && !root.editor-is-checklist && root.editor-picture-body == root.editor-body
                ? root.editor-unplaced-pictures : root.editor-pictures;
            picture-count: root.editor-pictures.length;
            can-position-pictures: true;
            body-sel-anchor: root.editor-body-sel-anchor;
            body-sel-focus: root.editor-body-sel-focus;
            body-sel-seq: root.editor-body-sel-seq;
            add-image => { root.image-add-requested(); }
            open-picture(index) => { root.picture-opened(index); }
            position-picture(id, cursor) => { root.picture-positioned(id, cursor); }
            unposition-picture(id) => { root.picture-unpositioned(id); }
            read-requested => { root.read-requested(); }
            compare => { root.review-opened(); }
            edited => { root.editor-edited(); }
            close => { root.close-editor(); }
            open-link(url) => { root.open-preview-link(url); }
            toggle-pin => { root.toggle-pin(); }
            archive => { root.archive-toggled(); }
            trash => { root.trash-note(); }
            restore => { root.restore-note(); }
            delete-forever => { root.delete-forever(); }
            open-options => { root.open-options(); }
            open-reminder => { root.open-reminder(); }
            item-edited(position, text) => { root.item-edited(position, text); }
            item-toggled(position) => { root.item-toggled(position); }
            item-removed(position) => { root.item-removed(position); }
            item-added => { root.item-added(); }
            to-checklist => { root.to-checklist(); }
            to-text => { root.to-text(); }
            format-bold(anchor, focus) => { root.format-bold(anchor, focus); }
            format-italic(anchor, focus) => { root.format-italic(anchor, focus); }
            format-bullet(anchor, focus) => { root.format-bullet(anchor, focus); }
            format-link(anchor, focus) => { root.open-link-dialog(anchor, focus); }
            init => {
                if (root.editor-reading) {
                    keys.focus();
                } else if (root.editor-title == "" && root.editor-mode != View.trash) {
                    self.focus-title();
                } else {
                    self.focus();
                }
            }
        }

        // 2. Editor sub-dialogs: options, reminder, insert link
        if root.options-open: Dialog {
            title: "Note options";
            card-width: 460px;
            SectionLabel { text: "COLOR"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for swatch[index] in root.swatches: Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: swatch.none ? transparent : (Theme.dark ? swatch.dark : swatch.light);
                    border-width: index == root.editor-color-index ? 2px : 1px;
                    border-color: index == root.editor-color-index ? Theme.on-surface : Theme.outline;
                    accessible-role: radio-button;
                    accessible-checkable: true;
                    accessible-checked: index == root.editor-color-index;
                    accessible-label: swatch.name;
                    accessible-action-default => { root.color-picked(index, Theme.dark); }
                    if swatch.none: Path {
                        width: 22px;
                        height: 22px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M5 19 L19 5";
                        stroke: Theme.muted;
                        stroke-width: 2px;
                    }
                    if index == root.editor-color-index && !swatch.none: Icon {
                        width: 18px;
                        height: 18px;
                        path: Icons.check;
                        color: Theme.on-surface;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.color-picked(index, Theme.dark); }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.outline; }
            SectionLabel { text: "LABELS"; }
            if root.label-choices.length == 0: Text {
                text: "No labels yet. Add one below.";
                font-size: Type.body-small;
                color: Theme.muted;
            }
            options-labels := ScrollView {
                vertical-stretch: 1;
                height: min(260px, label-list.preferred-height);
                content-width: self.visible-width;
                content-height: label-list.preferred-height;
                label-list := VerticalLayout {
                    width: options-labels.visible-width;
                    spacing: 4px;
                    for choice in root.label-choices: HorizontalLayout {
                        spacing: 12px;
                        height: 36px;
                        CheckBox {
                            y: (parent.height - self.height) / 2;
                            checked: choice.on;
                            label: choice.name;
                            toggled => { root.label-toggled(choice.name); }
                        }
                        Text {
                            text: choice.name;
                            vertical-alignment: center;
                            font-size: Type.body-large;
                            color: Theme.on-surface;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                new-label-field := Field {
                    horizontal-stretch: 1;
                    text <=> root.new-label;
                    placeholder: "New label";
                    label: "New label name";
                    accepted => { root.label-created(root.new-label); }
                }
                PillButton {
                    y: (parent.height - self.height) / 2;
                    text: "Add";
                    strong: true;
                    enabled: root.new-label != "";
                    clicked => { root.label-created(root.new-label); }
                }
            }
            HorizontalLayout {
                alignment: end;
                PillButton {
                    text: "Done";
                    strong: true;
                    clicked => { root.options-open = false; }
                }
            }
        }

        if root.reminder-open: Dialog {
            title: "Set a reminder";
            card-width: 460px;
            Text {
                text: root.reminder-set ? "Choose a new time or remove this reminder." : "Choose when to be reminded. Times use your local time zone.";
                font-size: Type.body-small;
                color: Theme.on-surface-secondary;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                PillButton { text: "In 1 hour"; clicked => { root.reminder-preset(0); } }
                PillButton { text: "Tomorrow 9:00"; clicked => { root.reminder-preset(1); } }
                PillButton { text: "Next week"; clicked => { root.reminder-preset(2); } }
            }
            Field {
                text <=> root.reminder-input;
                placeholder: "YYYY-MM-DD HH:MM";
                label: "Reminder date and time in local time";
                accepted => { root.reminder-save(); }
            }
            Text {
                text: root.reminder-error != "" ? root.reminder-error : "Enter a local date and time, for example 2026-11-23 09:00.";
                font-size: Type.meta;
                color: root.reminder-error != "" ? Theme.danger : Theme.muted;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                if root.reminder-set: PillButton {
                    text: "Remove reminder";
                    danger: true;
                    clicked => { root.reminder-remove(); }
                }
                Rectangle { horizontal-stretch: 1; }
                PillButton { text: "Cancel"; clicked => { root.reminder-cancel(); } }
                PillButton {
                    text: "Set reminder";
                    strong: true;
                    enabled: root.reminder-input != "";
                    clicked => { root.reminder-save(); }
                }
            }
        }

        if root.link-dialog-open: Dialog {
            title: "Insert link";
            card-width: 440px;
            init => { link-label-field.focus-field(); }
            link-label-field := Field {
                text <=> root.link-label-text;
                placeholder: "Label (optional)";
                label: "Link label";
                accepted => { link-url-field.focus-field(); }
            }
            link-url-field := Field {
                text <=> root.link-url-text;
                placeholder: "https://example.com";
                label: "Link URL";
                accepted => { root.insert-link-submitted(); }
            }
            if root.link-error != "": Text {
                text: root.link-error;
                font-size: Type.body-small;
                color: Theme.danger;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PillButton {
                    text: "Cancel";
                    clicked => { root.link-dialog-open = false; }
                }
                PillButton {
                    text: "Insert";
                    strong: true;
                    clicked => { root.insert-link-submitted(); }
                }
            }
        }

        // 3. Filters and Edit labels sheets
        if root.filters-open: Rectangle {
            background: Theme.scrim;
            TouchArea { clicked => { root.filters-open = false; } }
            filters-card := Rectangle {
                x: (parent.width - self.width) / 2;
                y: 40px;
                width: min(600px, parent.width - 48px);
                height: parent.height - 80px;
                border-radius: Theme.radius-sheet;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.outline;
                drop-shadow-blur: 32px;
                drop-shadow-color: #00000066;
                accessible-role: groupbox;
                accessible-label: "Filters";
                TouchArea { }
                VerticalLayout {
                    HorizontalLayout {
                        padding: 16px;
                        padding-left: 24px;
                        spacing: 10px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            path: Icons.filter;
                        }
                        Text {
                            text: "Filters";
                            vertical-alignment: center;
                            font-size: Type.title;
                            font-weight: 700;
                            color: Theme.on-surface;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: Icons.close;
                            label: "Close filters";
                            clicked => { root.filters-open = false; }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.outline; }

                    filters-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: filters-body.preferred-height;
                        filters-body := VerticalLayout {
                            width: filters-scroll.visible-width;
                            padding: 24px;
                            padding-top: 16px;
                            spacing: 12px;
                            alignment: start;

                            SectionLabel { text: "WHERE"; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                FilterChip { text: "Notes"; on: root.view == View.notes; clicked => { root.view-selected(View.notes); } }
                                FilterChip { text: "Archive"; on: root.view == View.archive; clicked => { root.view-selected(View.archive); } }
                                FilterChip { text: "Trash"; on: root.view == View.trash; clicked => { root.view-selected(View.trash); } }
                            }

                            Rectangle { height: 1px; background: Theme.outline; }
                            SectionLabel { text: "COLORS"; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for swatch[index] in root.swatches: Rectangle {
                                    property <bool> on: root.filter-colors[index];
                                    width: 34px;
                                    height: 34px;
                                    border-radius: 17px;
                                    background: swatch.none ? transparent : (Theme.dark ? swatch.dark : swatch.light);
                                    border-width: self.on ? 2px : 1px;
                                    border-color: self.on ? Theme.on-surface : Theme.outline;
                                    accessible-role: checkbox;
                                    accessible-checkable: true;
                                    accessible-checked: self.on;
                                    accessible-label: swatch.name;
                                    accessible-action-default => { root.filter-color-toggled(index); }
                                    if swatch.none && !root.filter-colors[index]: Path {
                                        width: 20px;
                                        height: 20px;
                                        viewbox-width: 24;
                                        viewbox-height: 24;
                                        commands: "M5 19 L19 5";
                                        stroke: Theme.muted;
                                        stroke-width: 2px;
                                    }
                                    if root.filter-colors[index]: Icon {
                                        width: 16px;
                                        height: 16px;
                                        path: Icons.check;
                                        color: Theme.on-surface;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.filter-color-toggled(index); }
                                    }
                                }
                            }

                            if root.filter-label-rows.length > 0: Rectangle { height: 1px; background: Theme.outline; }
                            if root.filter-label-rows.length > 0: HorizontalLayout {
                                spacing: 8px;
                                SectionLabel {
                                    text: "LABELS";
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.filter-label-count > 1: FilterChip {
                                    text: root.filter-label-all ? "All of these" : "Any of these";
                                    on: root.filter-label-all;
                                    clicked => { root.filter-label-match-toggled(); }
                                }
                            }
                            if root.filter-label-rows.length > 0: VerticalLayout {
                                spacing: 8px;
                                for row in root.filter-label-rows: ChipRow {
                                    items: row.items;
                                    picked(choice) => { root.filter-label-toggled(choice.text); }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.outline; }
                            SectionLabel { text: "STATUS"; }
                            VerticalLayout {
                                spacing: 8px;
                                for row in root.filter-flag-rows: ChipRow {
                                    items: row.items;
                                    picked(choice) => { root.filter-flag-toggled(choice.index); }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.outline; }
                            SectionLabel { text: "DATE"; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for choice in root.filter-date-fields: FilterChip {
                                    text: choice.text;
                                    on: choice.on;
                                    clicked => { root.filter-date-field-picked(choice.index); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for choice in root.filter-presets: FilterChip {
                                    text: choice.text;
                                    on: choice.on;
                                    clicked => { root.filter-preset-picked(choice.index); }
                                }
                            }

                            if root.saved-filters.length > 0: Rectangle { height: 1px; background: Theme.outline; }
                            if root.saved-filters.length > 0: SectionLabel { text: "SAVED"; }
                            for row in root.saved-filters: HorizontalLayout {
                                spacing: 4px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 40px;
                                    border-radius: Theme.radius-md;
                                    background: row.current ? Theme.surface-variant : (saved-touch.has-hover ? Theme.hover : transparent);
                                    accessible-role: button;
                                    accessible-label: row.label;
                                    accessible-action-default => { root.saved-applied(row.label); }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        spacing: 12px;
                                        Icon {
                                            y: (parent.height - self.height) / 2;
                                            width: 18px;
                                            height: 18px;
                                            path: Icons.bookmark;
                                            color: Theme.muted;
                                        }
                                        Text {
                                            text: row.label;
                                            vertical-alignment: center;
                                            font-size: Type.body;
                                            font-weight: row.current ? 600 : 400;
                                            color: Theme.on-surface;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    saved-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.saved-applied(row.label); }
                                    }
                                }
                                IconButton {
                                    y: (parent.height - self.height) / 2;
                                    size: 32px;
                                    icon: Icons.close;
                                    label: "Delete saved filter " + row.label;
                                    clicked => { root.saved-deleted(row.label); }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.outline; }
                    if root.naming: VerticalLayout {
                        padding: 16px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 8px;
                        Text {
                            text: "Name this filter";
                            font-size: Type.body;
                            font-weight: 600;
                            color: Theme.on-surface;
                        }
                        Field {
                            text <=> root.filter-name;
                            placeholder: "e.g. Invoices this month";
                            label: "Filter name";
                            edited => { root.filter-name-edited(self.text); }
                            accepted => { root.filter-saved(root.filter-name); }
                            init => { self.focus-field(); }
                        }
                        if root.filter-name-hint != "": Text {
                            text: root.filter-name-hint;
                            font-size: Type.meta;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            PillButton {
                                text: "Cancel";
                                clicked => { root.naming = false; }
                            }
                            PillButton {
                                text: "Save";
                                strong: true;
                                enabled: root.filter-name != "";
                                clicked => { root.filter-saved(root.filter-name); }
                            }
                        }
                    }
                    if !root.naming: HorizontalLayout {
                        padding: 16px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 8px;
                        PillButton {
                            text: "Save these filters";
                            enabled: root.filters-active;
                            clicked => {
                                root.filter-name = "";
                                root.filter-name-edited("");
                                root.naming = true;
                            }
                        }
                        PillButton {
                            text: "Clear all";
                            enabled: root.filters-active;
                            clicked => { root.filters-cleared(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        PillButton {
                            text: root.note-count == 1 ? "Show 1 note" : "Show " + root.note-count + " notes";
                            strong: true;
                            clicked => { root.filters-open = false; }
                        }
                    }
                }
            }
        }

        if root.labels-open: Dialog {
            title: "Edit labels";
            card-width: 460px;
            HorizontalLayout {
                spacing: 8px;
                Field {
                    horizontal-stretch: 1;
                    text <=> root.labels-new;
                    placeholder: "Create a label";
                    label: "Create a label";
                    accepted => { root.labels-created(root.labels-new); }
                }
                PillButton {
                    y: (parent.height - self.height) / 2;
                    text: "Create";
                    strong: true;
                    enabled: root.labels-new != "";
                    clicked => { root.labels-created(root.labels-new); }
                }
            }
            if root.all-labels.length == 0: Text {
                text: "No labels yet.";
                font-size: Type.body-small;
                color: Theme.muted;
            }
            edit-scroll := ScrollView {
                vertical-stretch: 1;
                height: min(320px, edit-list.preferred-height);
                content-width: self.visible-width;
                content-height: edit-list.preferred-height;
                edit-list := VerticalLayout {
                    width: edit-scroll.visible-width;
                    spacing: 6px;
                    for name in root.all-labels: HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            path: Icons.label;
                            color: Theme.muted;
                        }
                        rename := Field {
                            horizontal-stretch: 1;
                            text: name;
                            placeholder: name;
                            label: "Rename " + name;
                            accepted => {
                                if (self.text != name && self.text != "") {
                                    root.label-renamed(name, self.text);
                                }
                            }
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            size: 36px;
                            icon: Icons.trash;
                            label: "Delete label " + name;
                            clicked => { root.label-deleted(name); }
                        }
                    }
                }
            }
            Text {
                text: "Press Enter to rename. Deleting a label keeps its notes.";
                font-size: Type.meta;
                color: Theme.muted;
            }
            HorizontalLayout {
                alignment: end;
                PillButton {
                    text: "Done";
                    strong: true;
                    clicked => { root.labels-open = false; }
                }
            }
        }

        // 4. Settings workspace (below its modal workflows)
        if root.settings-open: settings-page := SettingsWorkspace {
            back => { root.settings-open = false; }
            settings-scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: settings-content.preferred-height;
                settings-content := VerticalLayout {
                    width: settings-scroll.visible-width;
                    padding-left: settings-page.content-inset;
                    padding-right: settings-page.content-inset;
                    padding-top: 24px;
                    padding-bottom: 32px;
                    spacing: 16px;
                    SettingsCard {
                        SectionLabel { text: "APPEARANCE"; }
                        Text {
                            text: "Theme";
                            font-size: Type.body;
                            font-weight: 500;
                            color: Theme.on-surface;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            accessible-role: radio-group;
                            accessible-label: "Theme";
                            theme-system := ThemeOption {
                                text: "System"; option-index: 0; selected: root.theme-mode == 0;
                                clicked => { root.theme-picked(0); }
                                move-option(index) => {
                                    root.theme-picked(index);
                                    if (index == 0) { theme-system.focus-option(); }
                                    else if (index == 1) { theme-light.focus-option(); }
                                    else { theme-dark.focus-option(); }
                                }
                            }
                            theme-light := ThemeOption {
                                text: "Light"; option-index: 1; selected: root.theme-mode == 1;
                                clicked => { root.theme-picked(1); }
                                move-option(index) => {
                                    root.theme-picked(index);
                                    if (index == 0) { theme-system.focus-option(); }
                                    else if (index == 1) { theme-light.focus-option(); }
                                    else { theme-dark.focus-option(); }
                                }
                            }
                            theme-dark := ThemeOption {
                                text: "Dark"; option-index: 2; selected: root.theme-mode == 2;
                                clicked => { root.theme-picked(2); }
                                move-option(index) => {
                                    root.theme-picked(index);
                                    if (index == 0) { theme-system.focus-option(); }
                                    else if (index == 1) { theme-light.focus-option(); }
                                    else { theme-dark.focus-option(); }
                                }
                            }
                        }

                        Text {
                            text: "Accent";
                            font-size: Type.body;
                            font-weight: 500;
                            color: Theme.on-surface;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            accessible-role: radio-group;
                            accessible-label: "Accent";
                            accent-neutral := ThemeOption {
                                text: "Neutral"; option-index: 0; selected: root.theme-accent == 0;
                                clicked => { root.accent-picked(0); }
                                move-option(index) => {
                                    root.accent-picked(index);
                                    if (index == 0) { accent-neutral.focus-option(); }
                                    else if (index == 1) { accent-blue.focus-option(); }
                                    else { accent-green.focus-option(); }
                                }
                            }
                            accent-blue := ThemeOption {
                                text: "Blue"; option-index: 1; selected: root.theme-accent == 1;
                                clicked => { root.accent-picked(1); }
                                move-option(index) => {
                                    root.accent-picked(index);
                                    if (index == 0) { accent-neutral.focus-option(); }
                                    else if (index == 1) { accent-blue.focus-option(); }
                                    else { accent-green.focus-option(); }
                                }
                            }
                            accent-green := ThemeOption {
                                text: "Green"; option-index: 2; selected: root.theme-accent == 2;
                                clicked => { root.accent-picked(2); }
                                move-option(index) => {
                                    root.accent-picked(index);
                                    if (index == 0) { accent-neutral.focus-option(); }
                                    else if (index == 1) { accent-blue.focus-option(); }
                                    else { accent-green.focus-option(); }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.outline.transparentize(0.45); }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            CheckBox {
                                y: (parent.height - self.height) / 2;
                                checked: root.theme-amoled;
                                label: "AMOLED black";
                                toggled => { root.amoled-toggled(); }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "AMOLED black";
                                    font-size: Type.body;
                                    font-weight: 500;
                                    color: Theme.on-surface;
                                }
                                Text {
                                    text: "Pure black surfaces in dark mode.";
                                    font-size: Type.meta;
                                    color: Theme.muted;
                                }
                            }
                        }
                    }

                    SettingsCard {
                        SectionLabel { text: "BACKUPS"; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            PillButton { text: "Export JSON"; clicked => { root.backup-export-json-requested(); } }
                            PillButton { text: "Export with pictures"; clicked => { root.backup-export-bundle-requested(); } }
                            PillButton { text: "Import"; label: "Import backup from settings"; clicked => { root.backup-import-requested(); } }
                        }
                    }

                    SettingsCard {
                        SectionLabel { text: "CLOUD & ACCOUNT"; }
                        if root.account-mode == 0: Text {
                            text: "Sync is not configured in this build. Notes stay on this device.";
                            font-size: Type.body-small;
                            color: Theme.on-surface-secondary;
                            wrap: word-wrap;
                        }
                        if root.account-mode == 1: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Guest mode. Notes stay on this device.";
                                font-size: Type.body-small;
                                color: Theme.on-surface-secondary;
                            }
                            HorizontalLayout {
                                alignment: start;
                                PillButton { text: "Sign in to sync"; strong: true; clicked => { root.signin-opened(); } }
                            }
                        }
                        if root.account-mode == 2: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: root.account-email;
                                font-size: Type.body;
                                font-weight: 600;
                                color: Theme.on-surface;
                            }
                            Text {
                                text: root.account-status;
                                font-size: Type.body-small;
                                color: root.account-problem ? Theme.danger : Theme.on-surface-secondary;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                PillButton { text: root.syncing ? "Syncing…" : "Sync now"; enabled: !root.syncing; clicked => { root.sync-requested(); } }
                                PillButton { text: "Sign out"; clicked => { root.sign-out-requested(); } }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                PillButton {
                                    text: "Delete cloud notes";
                                    danger: true;
                                    enabled: !root.syncing && !root.deleting-account;
                                    clicked => { root.delete-cloud-data-requested(); }
                                }
                                PillButton {
                                    text: "Delete account";
                                    danger: true;
                                    enabled: root.can-delete-account && !root.deleting-account;
                                    clicked => { root.delete-account-opened(); }
                                }
                            }
                        }
                        if root.account-mode == 2: Text {
                            text: "Account deletion permanently removes the online account, its notes, and pictures.";
                            font-size: Type.meta;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }

                    SettingsCard {
                        SectionLabel { text: "DIAGNOSTICS"; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            PillButton { text: "View diagnostics"; clicked => { root.diagnostics-requested(); } }
                            PillButton { text: "About"; label: "Open about dialog"; clicked => { root.about-open = true; } }
                        }
                    }
                }
            }
        }

        // 5. Sub-sheets & modal workflows above Settings
        if root.signin-open: Dialog {
            title: root.signin-step == 2 ? "Enter your code" : "Sign in to Notelikeus";
            card-width: 440px;
            if root.signin-step == 0: Text {
                text: "Notes are saved on this device. Sign in with your email to sync them across Android, Windows and the web.";
                font-size: Type.body;
                color: Theme.on-surface-secondary;
                wrap: word-wrap;
            }
            if root.signin-step == 0: Field {
                text <=> root.signin-email;
                placeholder: "you@example.com";
                label: "Email";
                accepted => { root.signin-send(); }
                init => { self.focus-field(); }
            }
            if root.signin-step == 0: Text {
                text: "We'll email you a 6-digit code. No password needed.";
                font-size: Type.meta;
                color: Theme.muted;
                wrap: word-wrap;
            }
            if root.signin-step == 1: Text {
                text: "Finish the quick security check in your browser. Notelikeus carries on by itself when it's done.";
                font-size: Type.body;
                color: Theme.on-surface-secondary;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: self.text;
            }
            if root.signin-step == 2: Text {
                text: "Sent to " + root.signin-email + ". Check spam if it hasn't arrived.";
                font-size: Type.body;
                color: Theme.on-surface-secondary;
                wrap: word-wrap;
            }
            if root.signin-step == 2: Field {
                text <=> root.signin-code;
                placeholder: "000000";
                label: "6-digit code";
                accepted => { root.signin-verify(); }
                init => { self.focus-field(); }
            }
            if root.signin-notice != "": Text {
                text: root.signin-notice;
                font-size: Type.body-small;
                color: Theme.on-surface-secondary;
                wrap: word-wrap;
            }
            if root.signin-error != "": Text {
                text: root.signin-error;
                font-size: Type.body-small;
                color: Theme.danger;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: self.text;
            }
            if root.signin-step == 2: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                PillButton {
                    text: "Use a different email";
                    enabled: !root.signin-busy;
                    clicked => { root.signin-change-email(); }
                }
                PillButton {
                    text: root.signin-resend-in > 0 ? "Resend code in " + root.signin-resend-in + "s" : "Resend code";
                    label: "Resend code";
                    enabled: !root.signin-busy && root.signin-resend-in == 0;
                    clicked => { root.signin-resend(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                PillButton {
                    text: "Cancel";
                    clicked => { root.signin-cancelled(); }
                }
                if root.signin-step == 0: PillButton {
                    text: root.signin-busy ? "Sending code…" : "Send code";
                    label: "Send code";
                    strong: true;
                    enabled: !root.signin-busy;
                    clicked => { root.signin-send(); }
                }
                if root.signin-step == 2: PillButton {
                    text: root.signin-busy ? "Checking code…" : "Sign in";
                    label: "Sign in";
                    strong: true;
                    enabled: !root.signin-busy;
                    clicked => { root.signin-verify(); }
                }
            }
        }

        if root.review-open: Rectangle {
            background: Theme.scrim;
            TouchArea { }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 40px;
                width: min(860px, parent.width - 48px);
                height: min(parent.height - 80px, review-layout.preferred-height);
                border-radius: Theme.radius-sheet;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.outline;
                drop-shadow-blur: 32px;
                drop-shadow-color: #00000066;
                accessible-role: groupbox;
                accessible-label: "This note changed on two devices";
                review-layout := VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: "This note changed on two devices";
                        font-size: Type.title;
                        font-weight: 700;
                        color: Theme.on-surface;
                    }
                    Text {
                        text: "Nothing was lost. Pick what to keep. A version you don't keep goes to the trash, where you can still restore it.";
                        font-size: Type.body;
                        color: Theme.on-surface-secondary;
                        wrap: word-wrap;
                    }
                    if !root.review-has-original: Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.surface-variant;
                        HorizontalLayout {
                            padding: 12px;
                            Text {
                                text: "The note this copy came from couldn't be identified. It may have been renamed or deleted. You can keep the copy as an ordinary note or move it to the trash.";
                                font-size: Type.body-small;
                                color: Theme.on-surface;
                                wrap: word-wrap;
                            }
                        }
                    }
                    review-scroll := ScrollView {
                        vertical-stretch: 1;
                        preferred-height: versions.preferred-height;
                        content-width: self.visible-width;
                        content-height: versions.preferred-height;
                        versions := HorizontalLayout {
                            width: review-scroll.visible-width;
                            spacing: 12px;
                            alignment: stretch;
                            if root.review-has-original: ReviewVersion {
                                horizontal-stretch: 1;
                                heading: "CURRENT NOTE";
                                edited: root.review-original-edited;
                                note-title: root.review-original-title;
                                lines: root.review-original-lines;
                            }
                            ReviewVersion {
                                horizontal-stretch: 1;
                                heading: "CONFLICTED COPY";
                                edited: root.review-copy-edited;
                                note-title: root.review-copy-title;
                                lines: root.review-copy-lines;
                            }
                        }
                    }
                    if root.review-has-original: HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 12px;
                            border-radius: 3px;
                            background: Theme.caution-fill.transparentize(0.8);
                        }
                        Text {
                            text: "Highlighted lines appear in only one version.";
                            font-size: Type.meta;
                            color: Theme.muted;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        PillButton {
                            text: "Decide later";
                            clicked => { root.review-open = false; }
                        }
                        if root.review-has-original: PillButton {
                            text: "Keep current note";
                            clicked => { root.review-keep-original(); }
                        }
                        if root.review-has-original: PillButton {
                            text: "Keep conflicted copy";
                            clicked => { root.review-keep-copy(); }
                        }
                        if !root.review-has-original: PillButton {
                            text: "Move copy to Trash";
                            clicked => { root.review-keep-original(); }
                        }
                        PillButton {
                            text: "Keep both";
                            strong: true;
                            clicked => { root.review-keep-both(); }
                        }
                    }
                }
            }
        }

        if root.diagnostics-open: Dialog {
            title: "Diagnostics";
            card-width: 620px;
            init => { diagnostics-export.focus-button(); }
            Text {
                text: "This report contains app and sync counts only. It does not include note text, your email, or raw account identifiers.";
                font-size: Type.body-small;
                color: Theme.on-surface-secondary;
                wrap: word-wrap;
            }
            diag-edit := TextEdit {
                height: min(340px, max(160px, root.height - 250px));
                text: root.diagnostics-report;
                read-only: true;
                wrap: word-wrap;
                font-size: Type.meta;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PillButton {
                    text: "Copy report";
                    clicked => {
                        diag-edit.select-all();
                        diag-edit.copy();
                        root.diagnostics-copied();
                    }
                }
                diagnostics-export := PillButton {
                    text: "Export JSON";
                    clicked => { root.diagnostics-export-requested(); }
                }
                PillButton { text: "Done"; strong: true; clicked => { root.diagnostics-open = false; } }
            }
        }

        if root.about-open: Dialog {
            title: "About Notelikeus";
            card-width: 460px;
            init => { about-done.focus-button(); }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                BrandMark {
                    y: (parent.height - self.height) / 2;
                    size: 36px;
                    bg: Theme.on-surface;
                    stripe: Theme.surface;
                    ring: Theme.on-surface-secondary.transparentize(0.5);
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Notelikeus Rust · " + root.app-version;
                        font-size: Type.body;
                        font-weight: 600;
                        color: Theme.on-surface;
                    }
                    Text {
                        text: "Capture what matters";
                        font-size: Type.meta;
                        color: Theme.on-surface-secondary;
                    }
                }
            }
            AboutSlint { height: 90px; }
            HorizontalLayout {
                alignment: end;
                about-done := PillButton { text: "Done"; strong: true; clicked => { root.about-open = false; } }
            }
        }

        if root.delete-account-open: Dialog {
            title: "Delete account?";
            card-width: 480px;
            Text {
                text: "This permanently deletes your online account, synced notes, and pictures. It cannot be undone. Your separate guest notes stay on this device.";
                font-size: Type.body;
                color: Theme.on-surface-secondary;
                wrap: word-wrap;
            }
            Text {
                text: "Type DELETE to confirm. A recent sign-in is required.";
                font-size: Type.body-small;
                font-weight: 600;
                color: Theme.on-surface;
            }
            Field {
                text <=> root.delete-account-confirmation;
                placeholder: "DELETE";
                label: "Type DELETE to confirm account deletion";
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PillButton {
                    text: "Cancel";
                    enabled: !root.deleting-account;
                    clicked => {
                        root.delete-account-open = false;
                        root.delete-account-confirmation = "";
                    }
                }
                PillButton {
                    text: root.deleting-account ? "Deleting…" : "Delete permanently";
                    strong: true;
                    danger: true;
                    enabled: root.delete-account-confirmation == "DELETE" && !root.deleting-account;
                    clicked => { root.delete-account-confirmed(); }
                }
            }
        }

        // 6. Full-screen image viewer
        if root.viewer-open: Rectangle {
            background: #000000eb;
            accessible-role: groupbox;
            accessible-label: "Picture " + (root.viewer-index + 1) + " of " + root.viewer-count;
            TouchArea { clicked => { root.viewer-open = false; } }
            if root.viewer-picture.ready: canvas-keys := FocusScope {
                x: 72px;
                y: 72px;
                width: parent.width - 144px;
                height: parent.height - 144px;
                focus-on-tab-navigation: root.viewer-zoom-index > 0;
                focus-on-click: root.viewer-zoom-index > 0;
                accessible-role: groupbox;
                accessible-label: "Picture canvas";
                key-pressed(event) => {
                    if (root.viewer-zoom-index == 0) { return reject; }
                    if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                        canvas.content-x = clamp(canvas.content-x + (event.text == Key.LeftArrow ? 48px : -48px),
                            canvas.visible-width - canvas.content-width, 0px);
                        return accept;
                    }
                    if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                        canvas.content-y = clamp(canvas.content-y + (event.text == Key.UpArrow ? 48px : -48px),
                            canvas.visible-height - canvas.content-height, 0px);
                        return accept;
                    }
                    return reject;
                }
                canvas := ScrollView {
                    property <float> aspect: max(0.0001, root.viewer-picture.aspect);
                    // Reserve room for the scroll view's own chrome as well as the image gutter.
                    property <length> fit-height: min(self.height - 32px, (self.width - 32px) / self.aspect);
                    property <float> zoom: root.viewer-zoom;
                    content-width: max(self.visible-width, picture.width + 16px);
                    content-height: max(self.visible-height, picture.height + 16px);
                    mouse-drag-pan-enabled: root.viewer-zoom-index > 0;
                    changed zoom => {
                        self.content-x = (self.visible-width - self.content-width) / 2;
                        self.content-y = (self.visible-height - self.content-height) / 2;
                    }
                    picture := Image {
                        width: canvas.fit-height * canvas.aspect * canvas.zoom;
                        height: canvas.fit-height * canvas.zoom;
                        x: (canvas.content-width - self.width) / 2;
                        y: (canvas.content-height - self.height) / 2;
                        source: root.viewer-picture.image;
                        image-fit: contain;
                        accessible-label: "Enlarged picture";
                    }
                }
                if canvas-keys.has-focus: Rectangle {
                    border-width: 2px;
                    border-color: #ffffff;
                    background: transparent;
                }
            }
            if !root.viewer-picture.ready: Rectangle {
                width: min(420px, parent.width - 96px);
                height: viewer-msg.preferred-height + 28px;
                border-radius: Theme.radius-md;
                background: #1c1c1e;
                border-width: 1px;
                border-color: #ffffff2a;
                viewer-msg := Text {
                    width: parent.width - 32px;
                    text: root.viewer-picture.problem != "" ? root.viewer-picture.problem : "Loading…";
                    font-size: Type.body-large;
                    color: #f5f5f5;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                y: 16px;
                height: 48px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;
                Text {
                    text: root.viewer-count > 1 ? (root.viewer-index + 1) + " of " + root.viewer-count : "";
                    vertical-alignment: center;
                    font-size: Type.body;
                    font-weight: 600;
                    color: #f5f5f5;
                    horizontal-stretch: 1;
                }
                PillButton {
                    text: "−";
                    label: "Zoom out";
                    enabled: root.viewer-picture.ready && root.viewer-zoom-index > 0;
                    clicked => { root.viewer-zoom-index -= 1; }
                }
                PillButton {
                    text: root.viewer-zoom-index > 0 ? round(root.viewer-zoom * 100) + "%" : "Fit";
                    label: root.viewer-zoom-index > 0 ? "Fit picture to viewer, " + self.text + " of fit" : "Fit picture to viewer";
                    enabled: root.viewer-picture.ready && root.viewer-zoom-index > 0;
                    clicked => { root.viewer-zoom-index = 0; }
                }
                PillButton {
                    text: "+";
                    label: "Zoom in";
                    enabled: root.viewer-picture.ready && root.viewer-zoom-index < 4;
                    clicked => { root.viewer-zoom-index += 1; }
                }
                if !root.viewer-read-only: PillButton {
                    y: (parent.height - self.height) / 2;
                    text: "Remove image";
                    strong: true;
                    danger: true;
                    clicked => { root.picture-remove-requested(); }
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: #ffffff1f;
                    viewer-close := IconButton {
                        icon: Icons.close;
                        label: "Close picture";
                        fg-color: #ffffff;
                        clicked => { root.viewer-open = false; }
                        init => { self.focus(); }
                    }
                }
            }
            if root.viewer-count > 1: Rectangle {
                x: 16px;
                y: (parent.height - self.height) / 2;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: #ffffff1f;
                IconButton {
                    size: 44px;
                    icon: Icons.chevron-left;
                    label: "Previous picture";
                    fg-color: #ffffff;
                    clicked => { root.viewer-moved(-1); }
                }
            }
            if root.viewer-count > 1: Rectangle {
                x: parent.width - self.width - 16px;
                y: (parent.height - self.height) / 2;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: #ffffff1f;
                IconButton {
                    size: 44px;
                    icon: Icons.chevron-right;
                    label: "Next picture";
                    fg-color: #ffffff;
                    clicked => { root.viewer-moved(1); }
                }
            }
        }

        // 7. Confirmation modal above all sheets & dialogs
        if root.confirm-title != "": Dialog {
            title: root.confirm-title;
            init => { confirm-cancel.focus-button(); }
            Text {
                text: root.confirm-body;
                font-size: Type.body;
                color: Theme.on-surface-secondary;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                confirm-cancel := PillButton {
                    text: "Cancel";
                    clicked => { root.confirm-cancelled(); }
                }
                PillButton {
                    text: root.confirm-action;
                    strong: true;
                    danger: true;
                    clicked => { root.confirm-accepted(); }
                }
            }
        }

        // 8. Toast above everything
        if root.toast-text != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - (root.editor-open ? 64px : 32px);
            width: toast-row.preferred-width;
            height: 48px;
            border-radius: Theme.radius-md;
            background: Theme.on-surface;
            accessible-role: text;
            accessible-label: root.toast-text;
            toast-row := HorizontalLayout {
                padding-left: 18px;
                padding-right: root.toast-action == "" ? 18px : 8px;
                spacing: 12px;
                Text {
                    text: root.toast-text;
                    vertical-alignment: center;
                    font-size: Type.body;
                    color: Theme.background;
                }
                if root.toast-action != "": Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: action-text.preferred-width + 20px;
                    height: 34px;
                    border-radius: Theme.radius-sm;
                    background: action-touch.has-hover ? Theme.background.transparentize(0.85) : transparent;
                    accessible-role: button;
                    accessible-label: root.toast-action;
                    accessible-action-default => { root.toast-acted(); }
                    action-text := Text {
                        text: root.toast-action;
                        font-size: Type.body;
                        font-weight: 700;
                        color: Theme.background;
                    }
                    action-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toast-acted(); }
                    }
                }
            }
        }
    }
}

export component TrayIcon inherits SystemTrayIcon {
    icon: @image-url("images/icon.png");
    title: "Notelikeus";
    tooltip: "Notelikeus";
    visible: true;

    callback open-requested();
    callback new-note-requested();
    callback exit-requested();

    clicked => { root.open-requested(); }

    Menu {
        MenuItem {
            title: "Open Notelikeus";
            activated => { root.open-requested(); }
        }
        MenuItem {
            title: "New note";
            activated => { root.new-note-requested(); }
        }
        MenuItem {
            title: "Exit";
            activated => { root.exit-requested(); }
        }
    }
}


