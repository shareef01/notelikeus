// Design tokens from docs/design/tokens.json, the same values the web app and the Kotlin apps use.
// Light or dark follows the Windows setting.

import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Colours.
    out property <color> background: dark ? #101010 : #f4f4f2;
    out property <color> surface: dark ? #1b1b1b : #ffffff;
    out property <color> surface-variant: dark ? #272727 : #ececea;
    out property <color> on-surface: dark ? #ededed : #151515;
    out property <color> on-surface-secondary: dark ? #b0b0b0 : #4d4d4b;
    out property <color> muted: dark ? #949494 : #666663;
    out property <color> outline: dark ? #323232 : #d6d6d3;
    out property <color> accent: dark ? #a8c7fa : #0b57d0;
    out property <color> danger: dark ? #f2b8b5 : #b3261e;
    out property <color> hover: dark ? #ffffff0d : #0000000a;
    out property <color> scrim: #00000099;

    // Shape.
    out property <length> radius-note: 18px;
    out property <length> radius-sheet: 16px;
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;

    // Layout.
    out property <length> sidebar-width: 240px;
    out property <length> note-gap: 14px;
    out property <length> card-min-width: 300px;
}

/// The web app's icons (web/src/components/icons/Icons.tsx), 24x24 Material paths.
export global Icons {
    out property <string> notes: "M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z";
    out property <string> archive: "M20.54 5.23 19.15 3.5A2 2 0 0 0 17.59 3H6.41a2 2 0 0 0-1.56.5L3.46 5.23A2 2 0 0 0 3 6.6V8h18V6.6a2 2 0 0 0-.46-1.37zM5 10v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9H5zm2 2h10v7H7v-7z";
    out property <string> trash: "M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z";
    out property <string> add: "M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z";
    out property <string> back: "M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z";
    out property <string> pin: "M16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z";
    out property <string> pin-off: "M9.41 7.41 8 6l-1 1 1.41 1.41L9.41 7.41zM3.27 3 2 4.27l4 4V9H7c-1.66 0-3 1.34-3 3v2h2.18l2 2H5v2h5.97l4.73 4.73L21 19.73 3.27 3zM16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1h-2.18l2 2H16zM19 15v-2c0-1.66-1.34-3-3-3h-1.18l2 2H19z";
    out property <string> close: "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z";
}

/// A 24x24 icon drawn from one of the paths above.
export component Icon inherits Path {
    in property <string> path;
    in property <color> color: Theme.on-surface;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.path;
    fill: root.color;
    stroke-width: 0px;
}

/// A round icon button. `label` is what a screen reader announces.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> filled: false;
    in property <length> size: 40px;
    callback clicked();
    width: size;
    height: size;
    border-radius: self.height / 2;
    background: filled ? (touch.has-hover ? Theme.on-surface.transparentize(0.12) : Theme.on-surface) : (touch.has-hover ? Theme.hover : transparent);
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    Icon {
        path: root.icon;
        color: root.filled ? Theme.background : Theme.on-surface;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
