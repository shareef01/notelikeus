// Design tokens from docs/design/tokens.json, the same values the web app and the Kotlin apps use.
// Light or dark follows the Windows setting.

import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Colours.
    out property <color> background: dark ? #101010 : #f4f4f2;
    out property <color> surface: dark ? #1b1b1b : #ffffff;
    out property <color> surface-variant: dark ? #272727 : #ececea;
    out property <color> on-surface: dark ? #ededed : #151515;
    out property <color> on-surface-secondary: dark ? #b0b0b0 : #4d4d4b;
    out property <color> muted: dark ? #949494 : #666663;
    out property <color> outline: dark ? #323232 : #d6d6d3;
    out property <color> accent: dark ? #a8c7fa : #0b57d0;
    out property <color> danger: dark ? #f2b8b5 : #b3261e;
    out property <color> hover: dark ? #ffffff0d : #0000000a;
    out property <color> scrim: #00000099;

    // Shape.
    out property <length> radius-note: 18px;
    out property <length> radius-sheet: 16px;
    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;

    // Layout.
    out property <length> sidebar-width: 240px;
    out property <length> note-gap: 14px;
    out property <length> card-min-width: 300px;
}

