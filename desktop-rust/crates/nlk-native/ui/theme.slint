/// BrandMark: circular disc with five rounded-cap vertical bars, matching Kotlin's `BrandMark.kt`
/// (bar width = 8% of disc, gap = 6%, height = 50%, top = 25%, 1px ring at 50% secondary alpha).
export component BrandMark inherits Rectangle {
    in property <length> size: 36px;
    in property <color> bg: Theme.on-surface;
    in property <color> stripe: Theme.surface;
    in property <color> ring: Theme.on-surface-secondary.transparentize(0.5);
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.bg;
    border-width: 1px;
    border-color: root.ring;
    accessible-role: image;
    accessible-label: "Notelikeus";

    property <length> bar-w: root.size * 0.08;
    property <length> bar-gap: root.size * 0.06;
    property <length> bar-h: root.size * 0.50;
    property <length> total-w: 5 * root.bar-w + 4 * root.bar-gap;
    property <length> start-x: (root.size - root.total-w) / 2;
    property <length> top-y: root.size * 0.25;

    for idx in 5: Rectangle {
        x: root.start-x + idx * (root.bar-w + root.bar-gap);
        y: root.top-y;
        width: root.bar-w;
        height: root.bar-h;
        border-radius: root.bar-w / 2;
        background: root.stripe;
    }
}

/// A 24x24 icon drawn from one of the paths above.
export component Icon inherits Path {
    in property <string> path;
    in property <color> color: Theme.on-surface;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.path;
    fill: root.color;
    stroke-width: 0px;
}

/// A round icon button inheriting FocusScope so Windows UIA focus tracks the accessible control directly.
export component IconButton inherits FocusScope {
    in property <string> icon;
    in property <string> label;
    in property <bool> filled: false;
    in property <color> fg-color: filled ? Theme.background : Theme.on-surface;
    in property <length> size: 40px;
    in property <length> radius: self.height / 2;
    callback clicked();
    width: size;
    height: size;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    key-pressed(event) => {
        if (event.text == Key.Space || event.text == Key.Return) {
            root.clicked();
            return accept;
        }
        reject
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        border-width: root.has-focus ? 2px : 0;
        border-color: Theme.accent;
        background: root.filled ? (touch.has-hover ? Theme.on-surface.transparentize(0.12) : Theme.on-surface) : (touch.has-hover ? Theme.hover : transparent);

        Icon {
            path: root.icon;
            color: root.fg-color;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { if (root.focus-on-click) { root.focus(); } root.clicked(); }
        }
    }
}
